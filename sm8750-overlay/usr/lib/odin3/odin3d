def steam_url(url: str) -> None:
    """Send steam:// URL command to the running Steam instance as user steamos."""
    try:
        uid = pwd.getpwnam("steamos").pw_uid
    except KeyError:
        return
    env = {
        "HOME": "/home/steamos",
        "USER": "steamos",
        "DISPLAY": ":0",
        "XDG_RUNTIME_DIR": f"/run/user/{uid}",
        "PATH": "/usr/bin:/bin",
    }
    subprocess.Popen(
        ["runuser", "-u", "steamos", "--", "/usr/bin/steam", "-ifrunning", url],
        env=env,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def desktop_running() -> bool:
    """Check if KDE Plasma desktop shell is currently running."""
    return subprocess.run(["pgrep", "-x", "plasmashell"], stdout=subprocess.DEVNULL).returncode == 0


def power_press(long: bool) -> None:
    """Handle power button press according to current session mode (Game Mode vs Desktop)."""
    if not desktop_running():
        # Game Mode: forward to Steam's internal power press handlers
        # Short press puts Steam Deck/handheld into sleep
        # Long press displays Steam's Power overlay menu
        steam_url("steam://longpowerpress" if long else "steam://shortpowerpress")
        return

    # Desktop Mode (Plasma):
    if not long:
        log("Power short press (Desktop): suspending system")
        subprocess.Popen(["systemctl", "suspend"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return

    log("Power long press (Desktop): triggering KDE logout/shutdown prompt")
    try:
        uid = pwd.getpwnam("steamos").pw_uid
    except KeyError:
        return
    env = {
        "HOME": "/home/steamos",
        "USER": "steamos",
        "PATH": "/usr/bin:/bin",
        "XDG_RUNTIME_DIR": f"/run/user/{uid}",
        "DBUS_SESSION_BUS_ADDRESS": f"unix:path=/run/user/{uid}/bus",
    }
    subprocess.Popen(
        ["runuser", "-u", "steamos", "--", "qdbus6", "org.kde.LogoutPrompt", "/LogoutPrompt", "org.kde.LogoutPrompt.promptShutDown"],
        env=env,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


class PowerButtonManager:
    """Monitors PMIC power key (/dev/input/event0) and dispatches short/long press events."""

    def __init__(self):
        self.fd: int | None = None
        self.dev_path: str | None = None
        self.last_boot = time.clock_gettime(time.CLOCK_BOOTTIME)
        self.last_wake = 0.0
        self.power_down_at: float | None = None
        self.power_long_sent = False
        self.last_scan = 0.0
        self.open_device()

    def find_device(self) -> str | None:
        for ev in glob.glob("/sys/class/input/event*"):
            try:
                with open(f"{ev}/device/name", encoding="utf-8") as fh:
                    if fh.read().strip() == "pmic_pwrkey":
                        return f"/dev/input/{os.path.basename(ev)}"
            except OSError:
                pass
        return None

    def open_device(self) -> None:
        if self.fd is not None:
            try:
                os.close(self.fd)
            except OSError:
                pass
            self.fd = None
            self.dev_path = None

        path = self.find_device()
        if not path:
            return

        try:
            self.fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
            self.dev_path = path
            log(f"Power button monitoring initialized on {path}")
        except OSError as e:
            log(f"Failed to open power device {path}: {e}")
            self.fd = None

    def get_fd(self) -> int | None:
        if self.fd is None and (time.monotonic() - self.last_scan > 5.0):
            self.last_scan = time.monotonic()
            self.open_device()
        return self.fd

    def check_resume(self) -> None:
        now_boot = time.clock_gettime(time.CLOCK_BOOTTIME)
        # Select timeout is at most 0.5s. If CLOCK_BOOTTIME advanced by > 1.5s,
        # the system woke from kernel suspend (s2idle).
        if now_boot - self.last_boot > 1.5:
            log(f"System resumed from sleep (slept {now_boot - self.last_boot:.1f}s)")
            self.last_wake = now_boot
            self.power_down_at = None
            self.power_long_sent = False
        self.last_boot = now_boot

    def handle_events(self) -> None:
        if self.fd is None:
            return

        now_boot = time.clock_gettime(time.CLOCK_BOOTTIME)
        try:
            data = os.read(self.fd, INPUT_EVENT_STRUCT.size * 32)
        except (BlockingIOError, InterruptedError):
            return
        except OSError as e:
            log(f"Power device read error: {e}, reopening...")
            self.open_device()
            return

        for off in range(0, len(data) - INPUT_EVENT_STRUCT.size + 1, INPUT_EVENT_STRUCT.size):
            _, _, etype, code, value = INPUT_EVENT_STRUCT.unpack_from(data, off)
            if etype == EV_KEY and code == KEY_POWER:
                # Discard events occurring within the wake grace period
                if now_boot - self.last_wake < WAKE_GRACE_S:
                    log(f"Ignored power key event (val={value}) during resume grace period")
                    self.power_down_at = None
                    continue

                if value == 1:
                    # Key down
                    self.power_down_at = time.monotonic()
                    self.power_long_sent = False
                elif self.power_down_at is not None:
                    # Key up
                    if not self.power_long_sent:
                        log("Power short press detected")
                        power_press(long=False)
                    self.power_down_at = None

    def check_hold(self) -> None:
        """Check if the power button has been held long enough to trigger a long press."""
        if self.power_down_at is not None and not self.power_long_sent:
            if time.monotonic() - self.power_down_at >= LONG_PRESS_S:
                log(f"Power long press (held >={LONG_PRESS_S}s) detected")
                self.power_long_sent = True
                power_press(long=True)

    def is_holding(self) -> bool:
        return self.power_down_at is not None

    def cleanup(self) -> None:
        if self.fd is not None:
            try:
                os.close(self.fd)
            except OSError:
                pass
            self.fd = None


class Odin3Daemon:
    def __init__(self):
        self.config = Config()
        self.state = StateManager()
        self.hw = Hardware(self.config)
        self.fan = FanController(self.hw, self.config, self.state)
        self.power = PowerManager(self.config)
        self.leds = LedManager()
        self.power_btn = PowerButtonManager()
        self.running = True
        self.server_sock: socket.socket | None = None

        signal.signal(signal.SIGTERM, self._sig_handler)
        signal.signal(signal.SIGINT, self._sig_handler)
        signal.signal(signal.SIGHUP, self._sighup_handler)
        atexit.register(self.cleanup)

    def _sig_handler(self, signum, frame):
        log(f"Received signal {signum}, stopping...")
        self.running = False

    def _sighup_handler(self, signum, frame):
        log("Received SIGHUP, reloading configuration and state...")
        self.config.reload()
        self.state.load()
        self.power.apply(self.state.data["profile"])

    def cleanup(self):
        log("Cleaning up odin3d resources...")
        # Not on shutdown: the device is off a few seconds later, the
        # failsafe only spun the fan up for that long.
        if not shutting_down():
            self.hw.set_failsafe()
        self.power_btn.cleanup()
        if self.server_sock:
            try:
                self.server_sock.close()
            except Exception:
                pass
        if os.path.exists(SOCK_PATH):
            try:
                os.remove(SOCK_PATH)
            except OSError:
                pass

    def setup_socket(self) -> None:
        os.makedirs(SOCK_DIR, exist_ok=True)
        if os.path.exists(SOCK_PATH):
            os.remove(SOCK_PATH)
        self.server_sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.server_sock.bind(SOCK_PATH)
        self.server_sock.listen(5)
        self.server_sock.setblocking(False)
        # Restrict control socket access to root and steamos group (mode 0660)
        gid = -1
        try:
            gid = grp.getgrnam("steamos").gr_gid
        except KeyError:
            try:
                gid = pwd.getpwnam("steamos").pw_gid
            except KeyError:
                gid = 1000  # Default GID for steamos group on SteamOS

        try:
            os.chown(SOCK_DIR, -1, gid)
            os.chmod(SOCK_DIR, 0o775)
        except OSError:
            pass

        try:
            os.chown(SOCK_PATH, -1, gid)
        except OSError as e:
            log(f"Warning: could not set steamos group on {SOCK_PATH}: {e}")

        try:
            os.chmod(SOCK_PATH, 0o660)
        except OSError as e:
            log(f"Warning: could not set permissions on {SOCK_PATH}: {e}")

    def handle_client(self, conn: socket.socket) -> None:
        try:
            conn.settimeout(2.0)
            data = conn.recv(4096)
            if not data:
                return
            req = data.decode(errors="replace").strip()
            resp = self.process_request(req)
            conn.sendall((json.dumps(resp) + "\n").encode())
        except Exception as e:
            log(f"socket request error: {e}")
        finally:
            conn.close()

    def process_request(self, req_str: str) -> dict[str, Any]:
        try:
            cmd = json.loads(req_str)
        except json.JSONDecodeError:
            # Fallback to plain text command parsing
            parts = req_str.split()
            if not parts:
                return {"error": "empty command"}
            action = parts[0]
            cmd = {"action": action, "args": parts[1:]}

        action = cmd.get("action", "")

        if action == "status":
            try:
                soc_temp = self.hw.get_soc_temp()
            except RuntimeError:
                soc_temp = 0.0
            cur_pwm = self.hw.get_pwm()
            return {
                "status": "ok",
                "device": "AYN Odin 3 (SM8750)",
                "soc_temp_c": round(soc_temp, 1),
                "hottest_zone": self.hw.hottest_zone_name,
                "fan_pwm": cur_pwm,
                "fan_pct": int(round(cur_pwm / 2.55)),
                "fan_mode": self.state.data["fan"].get("mode", "auto"),
                "fan_boost": self.state.data["fan"].get("boost", False),
                "profile": self.state.data.get("profile", "balanced"),
                "critical_override": self.fan.critical_override,
                "rgb": self.state.data.get("rgb", {}),
            }

        if action == "profile":
            val = cmd.get("value") or (cmd.get("args") and cmd["args"][0])
            if val == "next":
                idx = (PROFILES.index(self.state.data["profile"]) + 1) % len(PROFILES)
                val = PROFILES[idx]
            if val not in PROFILES:
                return {"error": f"invalid profile: {val}. Choices: {PROFILES}"}
            self.state.data["profile"] = val
            self.state.save()
            self.power.apply(val)
            self.leds.flash_profile(val)
            self.fan.tick()
            log(f"Profile switched to {val}")
            return {"status": "ok", "profile": val}

        if action in ("fan_auto", "auto"):
            self.state.data["fan"]["mode"] = "auto"
            self.state.data["fan"]["boost"] = False
            self.state.save()
            self.fan.tick()
            return {"status": "ok", "mode": "auto"}

        if action in ("fan_fixed", "fixed"):
            val = cmd.get("value") or (cmd.get("args") and cmd["args"][0])
            try:
                pct = max(0, min(100, int(val)))
            except (ValueError, TypeError):
                return {"error": "fixed speed must be 0-100%"}
            self.state.data["fan"]["mode"] = "fixed"
            self.state.data["fan"]["fixed"] = pct
            self.state.data["fan"]["boost"] = False
            self.state.save()
            self.fan.tick()
            return {"status": "ok", "mode": "fixed", "fixed": pct}

        if action in ("fan_boost", "boost"):
            cur = self.state.data["fan"].get("boost", False)
            val = cmd.get("value")
            new_val = (not cur) if val is None else bool(val)
            self.state.data["fan"]["boost"] = new_val
            self.state.save()
            self.fan.tick()
            return {"status": "ok", "boost": new_val}

        if action == "fan_set":
            val = cmd.get("value") or (cmd.get("args") and cmd["args"][0])
            try:
                pwm = max(0, min(255, int(val)))
            except (ValueError, TypeError):
                return {"error": "pwm must be 0-255"}
            self.hw.set_pwm(pwm)
            self.fan.cur_pwm = pwm
            return {"status": "ok", "pwm": pwm}

        if action == "rgb":
            color = cmd.get("color") or (cmd.get("args") and cmd["args"][0])
            bright = cmd.get("brightness") or (len(cmd.get("args", [])) > 1 and cmd["args"][1]) or 160
            self.state.data["rgb"]["mode"] = "static"
            self.state.data["rgb"]["color"] = str(color)
            self.state.data["rgb"]["brightness"] = int(bright)
            self.state.save()
            self.leds.set_color(str(color), int(bright))
            return {"status": "ok", "color": color, "brightness": bright}

        if action in ("rgb_off", "rgb-off"):
            self.state.data["rgb"]["mode"] = "off"
            self.state.save()
            self.leds.off()
            return {"status": "ok", "mode": "off"}

        return {"error": f"unknown action: {action}"}

    def run(self) -> None:
        log("Starting AYN Odin 3 platform daemon...")
        self.setup_socket()

        # Apply initial profile settings
        cur_prof = self.state.data.get("profile", "balanced")
        self.power.apply(cur_prof)
        self.leds.tick(self.state.data.get("rgb", {}))
        self.fan.tick()

        last_tick = time.monotonic()
        next_wifi = 0.0
        while self.running:
            try:
                self.power_btn.check_resume()

                # Adjust select timeout: 0.1s if user is currently holding power button, else 0.5s
                timeout = 0.1 if self.power_btn.is_holding() else 0.5

                r_fds = [self.server_sock]
                pwr_fd = self.power_btn.get_fd()
                if pwr_fd is not None:
                    r_fds.append(pwr_fd)

                r, _, _ = select.select(r_fds, [], [], timeout)

                self.power_btn.check_resume()

                if self.server_sock in r:
                    conn, _ = self.server_sock.accept()
                    self.handle_client(conn)

                if pwr_fd is not None and pwr_fd in r:
                    self.power_btn.handle_events()

                self.power_btn.check_hold()

                now = time.monotonic()
                if now - last_tick >= self.config.poll_interval:
                    self.fan.tick()
                    self.leds.tick(self.state.data.get("rgb", {}))
                    last_tick = now
                if now >= next_wifi:
                    next_wifi = now + 60.0
                    record_wifi()

            except Exception as e:
                log(f"loop exception: {e}")
                time.sleep(1.0)


def main():
    if os.geteuid() != 0:
        sys.exit("odin3d must run as root")
    daemon = Odin3Daemon()
    daemon.run()


if __name__ == "__main__":
    main()
