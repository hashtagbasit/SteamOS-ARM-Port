#!/usr/bin/env python3
"""Odin2 volume rocker: gpio-keys = VOLUP, pmic_resin = VOLDOWN → wpctl.

Do not grab USB/Bluetooth keyboards, mice, or the gamepad.

Holding a volume button keeps stepping until it is let go: these buttons
send no key repeats, so the step repeats here after HOLD_DELAY seconds, then
every HOLD_INTERVAL seconds.
"""
from __future__ import annotations

import array
import fcntl
import glob
import os
import select
import struct
import time
import subprocess
import sys

EVENT_FMT = "llHHi"
EVENT_SIZE = struct.calcsize(EVENT_FMT)
EV_KEY = 0x01
EV_REL = 0x02
REL_WHEEL = 0x08
KEY_MUTE = 113
KEY_VOLUMEDOWN = 114
KEY_VOLUMEUP = 115
STEP = os.environ.get("SM8550_VOLUME_STEP", "5%")
LIMIT = os.environ.get("SM8550_VOLUME_LIMIT", "1.0")
HOLD_DELAY = float(os.environ.get("SM8550_VOLUME_HOLD_DELAY", "0.4"))
HOLD_INTERVAL = float(os.environ.get("SM8550_VOLUME_HOLD_INTERVAL", "0.1"))
# InputPlumber's keyboard too: on the RP6 it grabs gpio-keys for the back
# paddles, so Volume Up only comes through its keyboard (a grabbed device's
# raw events reach nobody else, so nothing is counted twice).
ALLOW = ("gpio-keys", "pmic_resin", "pm8941_resin", "inputplumber keyboard")  # SM8550 / SM8250
# The AYANEO Pocket DMG's volume wheel: the mouse interface of "AYANEO DEVICE",
# a scroll wheel (InputPlumber leaves that interface alone on the DMG).
WHEEL = ("ayaneo device",)


def log(msg: str) -> None:
    print(f"sm8550-volume-keys: {msg}", flush=True)


def wpctl(*args: str) -> None:
    env = os.environ.copy()
    env.setdefault("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    try:
        subprocess.run(
            ["wpctl", *args],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=2,
            env=env,
        )
    except (FileNotFoundError, subprocess.TimeoutExpired):
        pass


def device_name(path: str) -> str:
    name = os.path.basename(path)
    sysname = f"/sys/class/input/{name}/device/name"
    try:
        return open(sysname, encoding="utf-8", errors="ignore").read().strip()
    except OSError:
        return ""


def has_volume_keys(fd: int) -> bool:
    buf = array.array("B", [0] * 96)
    nr = 0x20 + EV_KEY
    ioc = (2 << 30) | (ord("E") << 8) | nr | (len(buf) << 16)
    try:
        fcntl.ioctl(fd, ioc, buf, True)
    except OSError:
        return False

    def bit(code: int) -> bool:
        return bool(buf[code // 8] & (1 << (code % 8)))

    return bit(KEY_VOLUMEUP) or bit(KEY_VOLUMEDOWN) or bit(KEY_MUTE)


def has_wheel(fd: int) -> bool:
    buf = array.array("B", [0] * 2)
    ioc = (2 << 30) | (ord("E") << 8) | (0x20 + EV_REL) | (len(buf) << 16)
    try:
        fcntl.ioctl(fd, ioc, buf, True)
    except OSError:
        return False
    return bool(buf[REL_WHEEL // 8] & (1 << (REL_WHEEL % 8)))


def open_devices(skip: frozenset = frozenset()) -> list[tuple[str, int]]:
    opened: list[tuple[str, int]] = []
    for path in sorted(glob.glob("/dev/input/event*")):
        if path in skip:
            continue
        dname = device_name(path).lower()
        wheel_dev = any(a in dname for a in WHEEL)
        if not wheel_dev and not any(a in dname for a in ALLOW):
            continue
        try:
            fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
        except OSError:
            continue
        if not (has_wheel(fd) if wheel_dev else has_volume_keys(fd)):
            os.close(fd)
            continue
        log(f"watch {path} ({dname})")
        opened.append((path, fd))
    return opened


def pactl(*args: str) -> str:
    env = os.environ.copy()
    env.setdefault("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    try:
        return subprocess.run(["pactl", *args], check=False, capture_output=True,
                              text=True, timeout=2, env=env).stdout
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return ""


def apply(code: int) -> None:
    # Step in the same (PulseAudio/cubic) scale as Steam's volume bar. wpctl
    # steps in a different scale: from ~20 % on the bar one "5 %-" step hit
    # zero and muted the sink.
    if code == KEY_VOLUMEUP:
        pactl("set-sink-mute", "@DEFAULT_SINK@", "0")
        cur = pactl("get-sink-volume", "@DEFAULT_SINK@")
        pct = int(cur.split("/")[1].strip().rstrip("%")) if "/" in cur else 0
        limit = int(float(LIMIT) * 100)
        pactl("set-sink-volume", "@DEFAULT_SINK@", f"{min(limit, pct + int(STEP.rstrip('%')))}%")
    elif code == KEY_VOLUMEDOWN:
        pactl("set-sink-volume", "@DEFAULT_SINK@", f"-{STEP}")
    elif code == KEY_MUTE:
        pactl("set-sink-mute", "@DEFAULT_SINK@", "toggle")


def main() -> int:
    fds = {fd: path for path, fd in open_devices()}
    if not fds:
        log("no volume devices yet, waiting")
    last_scan = time.monotonic()
    held: tuple[int, int] | None = None   # (fd, key) of the volume key held down
    next_repeat = 0.0
    while True:
        # InputPlumber recreates its keyboard when its devices change: drop
        # handles that died and pick up new devices every 10 s.
        if time.monotonic() - last_scan >= 10:
            last_scan = time.monotonic()
            for fd, path in list(fds.items()):
                if not os.path.exists(path):
                    os.close(fd)
                    del fds[fd]
                    if held and held[0] == fd:
                        held = None
            for path, fd in open_devices(frozenset(fds.values())):
                fds[fd] = path
        if not fds:
            time.sleep(2)
            continue
        if held and time.monotonic() >= next_repeat:
            apply(held[1])
            next_repeat = max(next_repeat + HOLD_INTERVAL, time.monotonic())
        timeout = 2.0 if not held else max(0.0, next_repeat - time.monotonic())
        try:
            ready, _, _ = select.select(list(fds), [], [], timeout)
        except InterruptedError:
            continue
        for fd in ready:
            try:
                data = os.read(fd, EVENT_SIZE * 8)
            except OSError:
                log(f"lost {fds[fd]}")
                os.close(fd)
                del fds[fd]
                if held and held[0] == fd:
                    held = None
                continue
            for off in range(0, len(data) - EVENT_SIZE + 1, EVENT_SIZE):
                _s, _us, etype, code, value = struct.unpack_from(EVENT_FMT, data, off)
                if etype == EV_REL and code == REL_WHEEL and value:
                    apply(KEY_VOLUMEUP if value > 0 else KEY_VOLUMEDOWN)
                    continue
                if etype != EV_KEY:
                    continue
                if value == 1:
                    apply(code)
                    if code in (KEY_VOLUMEUP, KEY_VOLUMEDOWN):
                        held = (fd, code)
                        next_repeat = time.monotonic() + HOLD_DELAY
                elif value == 0 and held == (fd, code):
                    held = None
    return 0


if __name__ == "__main__":
    sys.exit(main())
