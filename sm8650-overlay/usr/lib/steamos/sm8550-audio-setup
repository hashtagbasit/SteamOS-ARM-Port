#!/bin/bash
# Bring up the internal speakers once the ASoC card appears.
#   SM8650 (KONKR Pocket FIT / AYANEO Pocket S2): card "SM8650-APS2",
#     WSA884x speakers + WCD939x headphones, UCM from ROCKNIX.
#   SM8550: card "AYN-Odin2" (Odin 2 / Mini / Portal, Retroid Pocket 6 / Nova:
#     aw88166 amps on MI2S), "AYN-Thor", "SM8550-APS" (AYANEO Pockets:
#     WSA884x), UCM from ROCKNIX.
#   SM8350 (REDMAGIC 6): card "sm8250 - REDMAGIC 6", fully set up by its UCM
#     (conf.d/sm8250/REDMAGIC 6.conf) when WirePlumber opens it.
# Name kept as sm8550-audio-setup so the existing units/udev rule apply.
set +e
export PATH="/usr/sbin:/usr/bin:/sbin:/bin${PATH:+:$PATH}"

log() { echo "sm8550-audio-setup: $*" >&2; }

# WirePlumber waits for this before it opens the card, so it never races
# alsaucm (that left the speakers silent on some boots). Set on every exit.
READY=/run/sm8550-audio-ready
trap 'touch "$READY"' EXIT

# ostree / image pack often leaves UCM dirs 700 steam:steam; root alsaucm
# then cannot read them and the speakers stay silent.
for d in /usr/share/alsa/ucm2/AYN /usr/share/alsa/ucm2/AYANEO /usr/share/alsa/ucm2/Qualcomm/sm8650 \
         /usr/share/alsa/ucm2/Nubia /usr/share/alsa/ucm2/conf.d/sm8250 \
         /usr/share/alsa/ucm2/conf.d/sm8550 /usr/share/alsa/ucm2/conf.d/sm8650 \
         /usr/share/alsa/ucm2/codecs /usr/share/alsa/ucm2/lib; do
  [[ -d "$d" ]] || continue
  find "$d" -type d -exec chmod 0755 {} + 2>/dev/null
  find "$d" -type f -exec chmod 0644 {} + 2>/dev/null
done

# Retroid Pocket (SM8250): WirePlumber applies the UCM, nothing to wait for.
if tr '\0' '\n' </sys/firmware/devicetree/base/compatible 2>/dev/null | grep -q '^retroidpocket,'; then
  log "Retroid Pocket card: UCM applied by WirePlumber"
  exit 0
fi

wait_card() {
  local i
  for i in $(seq 1 80); do
    grep -qiE 'APS|SM8650|AYN|Odin2|Thor|sm8550|REDMAGIC' /proc/asound/cards 2>/dev/null && return 0
    sleep 0.25
  done
  return 1
}

if ! wait_card; then
  log "no ASoC card yet"
  cat /proc/asound/cards >&2 || true
  exit 0
fi

# REDMAGIC 6: nothing to do here. Before it matched above, every boot sat
# out the whole 20 s wait while WirePlumber waited on us.
if grep -qi 'REDMAGIC' /proc/asound/cards; then
  log "REDMAGIC 6 card: UCM applied by WirePlumber"
  exit 0
fi

ucm() {
  local card="$1"
  command -v alsaucm >/dev/null 2>&1 || return 1
  alsaucm -c "$card" set _verb HiFi set _enadev Speaker >/tmp/sm8550-alsaucm.log 2>&1
}

if grep -qiE 'APS2|SM8650' /proc/asound/cards; then
  card_id="$(awk 'BEGIN{IGNORECASE=1} /APS2|SM8650/{print $1; exit}' /proc/asound/cards)"
  card_id="${card_id:-0}"
  log "SM8650 card ${card_id}: $(tr '\n' ' ' </proc/asound/cards 2>/dev/null)"
  if ucm SM8650-APS2 || ucm "hw:${card_id}"; then
    log "alsaucm SM8650-APS2 HiFi Speaker ok"
    # Speaker levels. The PA control's TLV label is misleading: the register
    # is inverted over 0..31 while the chip's gain table runs 0 = +21 dB ..
    # 18 = -6 dB, so "12" (+9 dB on the label) was really about -7.5 dB and
    # the speakers were far too quiet. 17 = G_0_DB, the cap the sc8280xp
    # machine driver itself enforces. The WSA digital stage starts at its
    # max; konkr-volume then drives it from Steam's bar with a usable curve
    # in hardware (attenuating the S16-only PCM in software crackled).
    amixer -c "$card_id" cset name='Speakers Volume' 17,17 >/dev/null 2>&1
    # The Pocket S2 keeps its volume on the digital stage (UCM "Speakers
    # Digital"): leave it to WirePlumber's saved level there.
    case "$(tr -d '\0' </sys/firmware/devicetree/base/model 2>/dev/null)" in
      "AYANEO Pocket S2"*) ;;
      *) amixer -c "$card_id" cset name='WSA_RX0 Digital Volume' 100% >/dev/null 2>&1
         amixer -c "$card_id" cset name='WSA_RX1 Digital Volume' 100% >/dev/null 2>&1 ;;
    esac
  else
    log "alsaucm failed — applying HiFi routes directly"
    cat /tmp/sm8550-alsaucm.log >&2 || true
    amixer -c "$card_id" cset name='WSA_CODEC_DMA_RX_0 Audio Mixer MultiMedia2' 1 >/dev/null 2>&1
    amixer -c "$card_id" cset name='RX_CODEC_DMA_RX_0 Audio Mixer MultiMedia1' 1 >/dev/null 2>&1
    amixer -c "$card_id" cset name='DISPLAY_PORT_RX_0 Audio Mixer MultiMedia1' 0 >/dev/null 2>&1
  fi
  exit 0
fi

# SM8550. /proc/asound/cards: " 0 [AYNThor        ]: AYN-Thor - AYN-Thor"
card_id="$(awk 'BEGIN{IGNORECASE=1} /AYN|Odin2|Thor|SM8550/{print $1; exit}' /proc/asound/cards)"
card_id="${card_id:-0}"
card_name="$(cat "/proc/asound/card${card_id}/id" 2>/dev/null)"
# "<id> [<name>]: <driver> - <longname>": the UCM profile is found by the long
# name (AYN-Thor, SM8550-APS). Thor's driver and long name are the same, the
# AYANEO Pockets' are not ("sm8550 - SM8550-APS"), so take what follows " - ".
card_long="$(awk -v c="$card_id" '$1==c {sub(/.*\]: */,""); sub(/^[^ ]+ - /,""); print; exit}' /proc/asound/cards)"
card_long="${card_long:-AYN-Odin2}"
log "card ${card_id} (${card_name} / ${card_long}): $(tr '\n' ' ' </proc/asound/cards 2>/dev/null)"

# By card number first: alsaucm then picks the profile from the card itself.
# "sm8550" (the driver name) was accepted too but routed nothing on a Pocket
# EVO (GitHub #32: no speaker sound).
if ucm "hw:${card_id}" || ucm "$card_long"; then
  log "alsaucm hw:${card_id} (${card_long}) HiFi Speaker ok"
else
  log "alsaucm failed"
  cat /tmp/sm8550-alsaucm.log >&2 || true
fi

# The AYANEO Pockets (WSA884x) and Thor are fully set up by their UCM.
if [[ "$card_long" != AYN-Odin2 ]]; then
  exit 0
fi

# AYN-Odin2: MI2S routes the Odin 2 was verified with, applied
# even when UCM succeeds.

amixer -c "$card_id" cset name='PRIMARY_MI2S_RX Audio Mixer MultiMedia1' 1 >/dev/null 2>&1
amixer -c "$card_id" cset name='RX_CODEC_DMA_RX_0 Audio Mixer MultiMedia2' 1 >/dev/null 2>&1
amixer -c "$card_id" cset name='DISPLAY_PORT_RX_0 Audio Mixer MultiMedia2' 0 >/dev/null 2>&1
amixer -c "$card_id" cset name='RX_RX0 Digital Volume' 84 >/dev/null 2>&1
amixer -c "$card_id" cset name='RX_RX1 Digital Volume' 84 >/dev/null 2>&1

log "card ${card_id} speaker mixers applied"
exit 0
