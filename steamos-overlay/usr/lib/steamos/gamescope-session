#!/bin/bash
# Handheld session: SM8650 (KONKR Pocket FIT / AYANEO Pocket S2) and SM8550
# (AYN Odin 2 family / Thor, AYANEO Pockets, Retroid Pocket 6 / Nova).
# Replaces the Steam Frame OpenVR gamescope command line.

# Create run directory file for startup and stats sockets
#   shellcheck disable=SC2030
tmpdir="$([[ -n ${XDG_RUNTIME_DIR+x} ]] && mktemp -p "$XDG_RUNTIME_DIR" -d -t gamescope.XXXXXXX)"
stats="${tmpdir:+$tmpdir/stats.pipe}"
#   shellcheck disable=SC2031
if [[ -z $tmpdir || -z ${XDG_RUNTIME_DIR+x} ]]; then
  echo >&2 "!! Failed to find run directory in which to create stats session sockets (is \$XDG_RUNTIME_DIR set?)"
  exit 0
fi

export GAMESCOPE_STATS="$stats"
mkfifo -- "$stats"

linkname="gamescope-stats"
#   shellcheck disable=SC2031
sessionlink="${XDG_RUNTIME_DIR:+$XDG_RUNTIME_DIR/}${linkname}"
lockfile="$sessionlink".lck
exec 9>"$lockfile"
if flock -n 9 && rm -f "$sessionlink" && ln -sf "$tmpdir" "$sessionlink"; then
  echo >&2 "Claimed global gamescope stats session at \"$sessionlink\""
else
  echo >&2 "!! Failed to claim global gamescope stats session"
fi

export GAMESCOPE_READY_NOTIFY_SOCKET="$NOTIFY_SOCKET"
unset NOTIFY_SOCKET

if [[ -f /usr/lib/steamos/gamescope-cleanup ]]; then
  # shellcheck disable=SC1091
  source /usr/lib/steamos/gamescope-cleanup
fi

export XCURSOR_THEME="${XCURSOR_THEME:-steam}"

# SM8550 / SM8250: GL through zink, else Xwayland has no glamor/GLX. mangoapp
# was off here because it needs GLX; with zink it has it again (the mangoapp
# wrapper leaves it on the image's own Turnip). Both images carry our
# Turnip-only Mesa, which has no native GL driver.
if grep -aq -e "qcom,sm8550" -e "qcom,sm8250" /sys/firmware/devicetree/base/compatible 2>/dev/null; then
  export MESA_LOADER_DRIVER_OVERRIDE=zink
fi

# Performance overlay (mangoapp). mangoapp is GL; GL on the Frame image is
# zink-on-Turnip only, and zink must run on the Turnip it was built with.
# The SM8550 port swapped Turnip, mangoapp crashed, so it switched the
# overlay off. Here a wrapper (first in PATH, see steamos-sm8650/bin/mangoapp)
# pins mangoapp to the Frame's own Turnip, so the overlay works whatever
# Turnip games use. GAMESCOPE_MANGOAPP=0 turns it off.
MANGOAPP=0
if [[ -x /usr/bin/mangoapp ]]; then
  MANGOAPP=1
  if [[ -x /usr/lib/steamos-sm8650/bin/mangoapp ]]; then
    export PATH="/usr/lib/steamos-sm8650/bin:${PATH}"
  elif [[ -e /opt/stock-steamos/usr/lib/libvulkan_freedreno.so ]]; then
    MANGOAPP=0   # swapped Turnip and no pinned copy: would crash
  fi
fi
if [[ "${GAMESCOPE_MANGOAPP:-auto}" == 0 ]]; then MANGOAPP=0; fi
if [[ "$MANGOAPP" == 1 ]]; then
  export GAMESCOPE_MANGOAPP_SOCKET_DISABLE=0
  export STEAM_USE_MANGOAPP=1
  export STEAM_MANGOAPP_PRESETS_SUPPORTED=1
  export STEAM_MANGOAPP_HORIZONTAL_SUPPORTED=1
  export STEAM_DISABLE_MANGOAPP_ATOM_WORKAROUND=1
  # A stable name, not mktemp's random one: Steam races gamescope-session
  # to write the real preset into this file before mangoapp's first read,
  # and losing that race (switch to Desktop and back, a bare
  # gamescope-session restart) left the overlay stuck on "no_display"
  # forever, since a fresh random name each time meant Steam's last write
  # was never seen again. Reusing one path across restarts within the same
  # login means mangoapp's first read already has Steam's last-known-good
  # content, so there's nothing to race.
  MANGOHUD_CONFIGFILE="$XDG_RUNTIME_DIR/mangohud-config"
  export MANGOHUD_CONFIGFILE
  [[ -s "$MANGOHUD_CONFIGFILE" ]] || echo "no_display" >"$MANGOHUD_CONFIGFILE"
else
  export GAMESCOPE_MANGOAPP_SOCKET_DISABLE=1
fi
export QT_IM_MODULE="${QT_IM_MODULE:-xim}"
export GTK_IM_MODULE="${GTK_IM_MODULE:-xim}"
export QT_QPA_PLATFORMTHEME="${QT_QPA_PLATFORMTHEME:-kde}"
# Compositor is Wayland (GAMESCOPE_WAYLAND_DISPLAY). Do not stamp
# XDG_SESSION_TYPE=wayland/x11 — Steam DisplayManager then leaves wayland: modeset.
unset XDG_SESSION_TYPE || true
export XDG_CURRENT_DESKTOP=gamescope
export XDG_SESSION_DESKTOP=gamescope
export DESKTOP_SESSION=gamescope
export QT_QPA_PLATFORM=xcb
export _STEAM_SETENV_MANAGER=1

export SteamDeck=1
export STEAM_MULTIPLE_XWAYLANDS=1
export STEAM_GAMESCOPE_HDR_SUPPORTED=0
if grep -zqxF "ayn,odin2portal" /sys/firmware/devicetree/base/compatible 2>/dev/null; then
  # The connector profile still decides whether HDR is available.
  export STEAM_GAMESCOPE_HDR_SUPPORTED=1
fi
export STEAM_ENABLE_VOLUME_HANDLER="${STEAM_ENABLE_VOLUME_HANDLER:-0}"
export SRT_URLOPEN_PREFER_STEAM=1
export ENABLE_GAMESCOPE_WSI=1
# No zenity pop-ups from the WSI layer (each one can start another, see
# environment.d/62-steamos-arm-no-wsi-dialogs.conf).
export GAMESCOPE_ZENITY_DISABLE=1
export SDL_VIDEO_MINIMIZE_ON_FOCUS_LOSS=0
export vk_xwayland_wait_ready=false
export GAMESCOPE_DISABLE_ASYNC_FLIPS=1
# MSM: KMS plane rotation is EINVAL on Adreno. Shader path is already in
# DRMBackend.cpp; keep it forced so a 0° probe cannot skip it.
# Portrait panel: rotate in the composite shader (safe everywhere). SM8650
# DPU can rotate UBWC buffers inline (ROCKNIX 0066); opt in with
# `konkrctl`-managed flag /var/lib/konkrd/kms-rotation, which lets gamescope
# scan games out directly instead of compositing every frame. Two failed
# starts in a row turn the flag off again.
# A monitor on USB-C/HDMI takes over Game Mode while it's connected (like the
# Deck): before, the panel was forced and an external screen stayed black in
# Game Mode, which also left HDMI/DP audio silent (no stream to carry it).
# GAMESCOPE_FORCE_INTERNAL=1 keeps the panel.
export GAMESCOPE_FORCE_INTERNAL="${GAMESCOPE_FORCE_INTERNAL:-0}"
# Same physical size the working SM8550 session advertises (not connector mm).
export GAMESCOPE_FAKE_OUTPUT_MM="${GAMESCOPE_FAKE_OUTPUT_MM:-177x100}"
if [[ "$MANGOAPP" != 1 ]]; then
  export STEAM_USE_MANGOAPP=0
  export STEAM_MANGOAPP_PRESETS_SUPPORTED=0
  export STEAM_MANGOAPP_HORIZONTAL_SUPPORTED=0
  export STEAM_DISABLE_MANGOAPP_ATOM_WORKAROUND=1
fi
export STEAM_GAMESCOPE_VRR_SUPPORTED=1
export STEAM_GAMESCOPE_HAS_TEARING_SUPPORT=1
export STEAM_GAMESCOPE_TEARING_SUPPORTED=1
export STEAM_GAMESCOPE_DYNAMIC_FPSLIMITER=1
export STEAM_GAMESCOPE_NIS_SUPPORTED=1
export STEAM_GAMESCOPE_FANCY_SCALING_SUPPORT=1
export STEAM_USE_DYNAMIC_VRS=1
export STEAM_GAMESCOPE_COLOR_MANAGED=1
export STEAM_ALLOW_DRIVE_UNMOUNT=1
export STEAM_ALLOW_DRIVE_ADOPT=1

export VK_ICD_FILENAMES="${VK_ICD_FILENAMES:-/usr/share/vulkan/icd.d/freedreno_icd.aarch64.json}"
export VK_DRIVER_FILES="${VK_DRIVER_FILES:-$VK_ICD_FILENAMES}"
export SDL_GAMECONTROLLERCONFIG_FILE="${SDL_GAMECONTROLLERCONFIG_FILE:-/etc/sdl2/qcom-gamecontrollerdb.txt}"
export SDL_VIDEO_X11_DGAMOUSE=0

# Native rsinput sticks: kernel reports ~±1408; emulators need ±740.
if [[ -x /usr/lib/steamos/sm8550-fixpad ]]; then
  /usr/lib/steamos/sm8550-fixpad apply 740 >/dev/null 2>&1 || true
fi

PANEL_W=1080
PANEL_H=1920
OUTPUT="${GAMESCOPE_OUTPUT:-}"
if [[ -z "$OUTPUT" ]]; then
  best_area=0
  for card in /sys/class/drm/card*-DSI-* /sys/class/drm/card*-eDP-*; do
    [[ -e "$card/status" ]] || continue
    [[ "$(cat "$card/status" 2>/dev/null || true)" == connected ]] || continue
    base="$(basename "$card")"
    name="${base#*-}"
    mode="$(head -1 "$card/modes" 2>/dev/null || true)"
    if [[ "$mode" =~ ^([0-9]+)x([0-9]+) ]]; then
      w="${BASH_REMATCH[1]}"
      h="${BASH_REMATCH[2]}"
      area=$((w * h))
      if (( area > best_area )); then
        best_area=$area
        OUTPUT="$name"
        PANEL_W="$w"
        PANEL_H="$h"
      fi
    fi
  done
  OUTPUT="${OUTPUT:-DSI-1}"
fi

KMS_ROT_FLAG=/var/lib/konkrd/kms-rotation
KMS_ROT_TRIES="$XDG_RUNTIME_DIR/gamescope-kms-rotation.tries"
KMS_ROTATION=0
# The DPU inline rotator caps the pre-rotation height at 1088: 1440x2560
# panels (Pocket S2, Pocket S 2K) can't use it.
PANEL_SHORT=$(( PANEL_W < PANEL_H ? PANEL_W : PANEL_H ))
if [[ -e "$KMS_ROT_FLAG" && "$PANEL_SHORT" -le 1088 ]]; then
  tries="$(cat "$KMS_ROT_TRIES" 2>/dev/null || echo 0)"
  if (( tries >= 2 )); then
    echo >&2 "gamescope-session: KMS rotation failed twice, falling back to shader"
  else
    echo $((tries + 1)) >"$KMS_ROT_TRIES"
    KMS_ROTATION=1
  fi
fi
if [[ "$KMS_ROTATION" == 1 ]]; then
  export GAMESCOPE_KMS_ROTATION=1
  unset GAMESCOPE_USE_ROTATION_SHADER
else
  export GAMESCOPE_USE_ROTATION_SHADER=1
fi
if [[ "$PANEL_H" -gt "$PANEL_W" ]]; then
  W="${GAMESCOPE_WIDTH:-$PANEL_H}"
  H="${GAMESCOPE_HEIGHT:-$PANEL_W}"
else
  W="${GAMESCOPE_WIDTH:-$PANEL_W}"
  H="${GAMESCOPE_HEIGHT:-$PANEL_H}"
fi
# Highest refresh the panel lists (Pocket FIT: 144/120/90/60 at one pixel
# clock, via kernel patch kernel-sm8650/patches/0003; ROCKNIX's driver alone
# lists only 144). gamescope collects every listed rate into its dynamic refresh
# table; --generate-drm-mode fixed keeps the pixel clock and stretches the
# vertical front porch for rates in between, like the listed modes do.
REFRESH_HZ="${GAMESCOPE_REFRESH:-}"
MIN_HZ=60
MAX_HZ="$(/usr/lib/steamos/panel-modes --max "$OUTPUT" 2>/dev/null)"
[[ "$MAX_HZ" =~ ^[0-9]+$ ]] || MAX_HZ=60
(( MAX_HZ >= 60 )) || MAX_HZ=60
# Retroid Pocket 5 / Flip 2 with the CH13726A OLED: 60 Hz only, the faster
# modes its driver lists don't hold on these panels (the Visionox versions do
# 120). Same limit as the other 865 Linux ports.
case "$(tr -d '\0' </sys/firmware/devicetree/base/model 2>/dev/null)" in
  "Retroid Pocket 5"|"Retroid Pocket Flip2") MAX_HZ=60; PANEL_60_ONLY=1 ;;
esac
# Start the Steam UI at 60 Hz: at 144 it redraws menus 144x/s, which roughly
# doubles UI GPU/CPU load (heat, fan, sluggishness). Steam's refresh slider
# (STEAM_DISPLAY_REFRESH_LIMITS) still reaches MAX_HZ per game.
REFRESH_HZ="${REFRESH_HZ:-60}"
# Steam reads two numbers here as a range and offers every rate in it, so the
# frame limiter fills with values the panel can only reach by stretching its
# timing. Hand it the rates the panel actually lists instead (Pocket FIT:
# 60,90,120,144 -> limits 30/60/90/120/144). Only a panel that lists a single
# rate above 60 Hz gets the old 60-to-max range, so it still has a slider.
PANEL_RATES="$(/usr/lib/steamos/panel-modes --rates "$OUTPUT" 2>/dev/null)"
[[ -n "${PANEL_60_ONLY:-}" ]] && PANEL_RATES=60
if [[ "$PANEL_RATES" =~ ^[0-9]+(,[0-9]+)+$ ]]; then
  export STEAM_DISPLAY_REFRESH_LIMITS="${STEAM_DISPLAY_REFRESH_LIMITS:-${PANEL_RATES}}"
elif (( MAX_HZ > 60 )); then
  export STEAM_DISPLAY_REFRESH_LIMITS="${STEAM_DISPLAY_REFRESH_LIMITS:-${MIN_HZ},${MAX_HZ}}"
fi

# Dual-screen handhelds: Game Mode only drives the main panel. Keep the second
# panel's touchscreen out of it, else touches on the dark screen land in Steam
# (both are I2C, gamescope would map both onto the main one).
DEVICE_MODEL="$(tr -d '\0' </sys/firmware/devicetree/base/model 2>/dev/null)"
# Steam's brightness slider goes through gamescope, which otherwise takes the
# first backlight: the bottom panel on both of these.
case "$DEVICE_MODEL" in
  "AYN Thor")
    # ROCKNIX names it bottom_touchscreen; the 7.0.14 kernel calls both
    # "generic ft5x06 (8d)", so also match the bottom one's I2C address
    # (top is 4-0038 on i2c4, bottom 1-0038, same as Armada's Thor tree).
    export GAMESCOPE_IGNORE_TOUCH="${GAMESCOPE_IGNORE_TOUCH:-bottom_touchscreen,path:/1-0038/}"
    # Top panel is DSI-2 on dsi1 (ae96000), the bottom DSI-1 on dsi0 (ae94000),
    # same as Armada's Thor. Beta 7 had these the other way round.
    TOP_BACKLIGHT=/sys/class/backlight/ae96000.dsi.0 ;;
  "AYN Thor Lite")
    # Same layout as the Thor on the 865: top panel on dsi1 (ae96000), the
    # bottom one on dsi0 (ae94000), touchscreens labelled like ROCKNIX's Thor.
    export GAMESCOPE_IGNORE_TOUCH="${GAMESCOPE_IGNORE_TOUCH:-bottom_touchscreen}"
    TOP_BACKLIGHT=/sys/class/backlight/ae96000.dsi.0 ;;
  "AYANEO Pocket DS")
    export GAMESCOPE_IGNORE_TOUCH="${GAMESCOPE_IGNORE_TOUCH:-Goodix Capacitive TouchScreen}"
    TOP_BACKLIGHT=/sys/class/backlight/ae94000.dsi.0 ;;
esac
# Only point gamescope at it when this kernel's device tree has that name
# (the paths are ROCKNIX's); otherwise leave gamescope's default.
if [[ -z "${GAMESCOPE_BACKLIGHT_PATH:-}" && -n "${TOP_BACKLIGHT:-}" && -e "$TOP_BACKLIGHT" ]]; then
  export GAMESCOPE_BACKLIGHT_PATH="$TOP_BACKLIGHT"
fi

# Panel orientation override (GAMESCOPE_ORIENTATION=left|right|normal|
# upsidedown). The RP6 / Odin 2 Portal trees say rotation 270 where the
# Odin 2 says 90, so those may need left (and the Thor right).
# Not forced here yet: our auto already shows the Thor right, and the RP6
# report is mirrored touch, not an upside-down picture.
PANEL_ORIENT="${GAMESCOPE_ORIENTATION:-}"
# Lenovo tablets: Game Mode turned the other way up (Handheld Control's "Flip
# screen", /etc/steamos-arm/flip-screen), for controllers that plug into the
# short side. Both run the panel "right"; touch follows through udev.
if [[ -e /etc/steamos-arm/flip-screen ]] && grep -aqE "lenovo,(tb321fu|elden|baldur)" /sys/firmware/devicetree/base/compatible 2>/dev/null; then
  PANEL_ORIENT=left
fi

# Bottom screen (bottom-screen.service): lend the second panel to its own
# gamescope through a DRM lease, where the dashboard runs. Off with
# "enabled": false in ~/.config/steamos-arm/bottom-screen.json; "connector"
# there picks another output (e.g. "DP-1" to try it on an external monitor).
rm -f "$XDG_RUNTIME_DIR/bottom-screen.env"
read -r BOTTOM_ENABLED BOTTOM_CONNECTOR < <(python3 - "$HOME/.config/steamos-arm/bottom-screen.json" <<'PY' 2>/dev/null || echo "1 "
import json, sys
try:
    cfg = json.load(open(sys.argv[1]))
except Exception:
    cfg = {}
print(0 if cfg.get("enabled") is False else 1, cfg.get("connector") or "")
PY
)
# "nobottomscreen" file on BOOT (bottom-screen-bootflag.service)
[[ -e /run/steamos-arm/bottom-screen-off ]] && BOTTOM_ENABLED=0
if [[ "${BOTTOM_ENABLED:-1}" == 1 ]]; then
  if [[ -z "${BOTTOM_CONNECTOR:-}" ]]; then
    BOTTOM_CONNECTOR="$(/usr/lib/steamos/panel-modes 2>/dev/null | awk -v o="$OUTPUT" '$1 != o {print $1; exit}')"
  fi
  if [[ -n "$BOTTOM_CONNECTOR" && "$BOTTOM_CONNECTOR" != "$OUTPUT" ]]; then
    export GAMESCOPE_LEASE_CONNECTOR="$BOTTOM_CONNECTOR"
    export GAMESCOPE_LEASE_SOCKET="$XDG_RUNTIME_DIR/gamescope-lease.sock"
    printf 'BOTTOM_CONNECTOR=%q\nBOTTOM_SOCKET=%q\nBOTTOM_TOUCH=%q\n' \
      "$BOTTOM_CONNECTOR" "$GAMESCOPE_LEASE_SOCKET" "${GAMESCOPE_IGNORE_TOUCH:-}" \
      >"$XDG_RUNTIME_DIR/bottom-screen.env"
  fi
fi

GAMESCOPE_SESSION_TARGET="${GAMESCOPE_SESSION_TARGET:-gamescope-session.target}"
WATCH_SERVICE=""

IS_ODIN3=0
if grep -aqE "ayn,odin3|qcom,sm8750" /sys/firmware/devicetree/base/compatible 2>/dev/null; then
  IS_ODIN3=1
fi

# Scanout format and buffer layout. The Legion Y700 Gen 4's display driver
# showed Game Mode black (backlight on, gamescope running) with gamescope's
# default 10-bit scanout, where its desktop runs 8-bit: 8 bpc there. The
# kernel cmdline can override both, so a boot.img can try a variant without
# touching the install: steamos.gamescope.8bit=0|1, steamos.gamescope.modifiers=0|1.
if grep -aq "lenovo,elden" /sys/firmware/devicetree/base/compatible 2>/dev/null; then
  export GAMESCOPE_PREFER_8BIT="${GAMESCOPE_PREFER_8BIT:-1}"
fi
for arg in $(cat /proc/cmdline 2>/dev/null); do
  case "$arg" in
    steamos.gamescope.8bit=*) export GAMESCOPE_PREFER_8BIT="${arg#*=}" ;;
    steamos.gamescope.modifiers=0) export GAMESCOPE_DISABLE_MODIFIERS=1 ;;
    steamos.gamescope.modifiers=1) unset GAMESCOPE_DISABLE_MODIFIERS ;;
  esac
done

# DRM backend = Wayland compositor + Xwayland. Steam paints on X11 (:0 / xcb).
# --backend wayland/sdl would nest inside another compositor and drop the panel.
GAMESCOPE_ARGS=(
  --backend drm
  --prefer-output "$OUTPUT"
)
if [[ "$GAMESCOPE_FORCE_INTERNAL" == 1 ]]; then
  GAMESCOPE_ARGS+=(--force-internal)
fi
GAMESCOPE_ARGS+=(
  --scaler fit
  --filter linear
  --steam
  --xwayland-count 2
  --adaptive-sync
  --default-touch-mode 4
  --hide-cursor-delay 3000
  --framerate-limit 0
  --max-scale 2
  --output-width "$W"
  --output-height "$H"
  --nested-width "$W"
  --nested-height "$H"
  --nested-refresh "$REFRESH_HZ"
  --generate-drm-mode fixed
  -T "$stats"
)

if [[ "$KMS_ROTATION" != 1 ]]; then
  # Shader rotation composites anyway; say so explicitly (MSM default).
  if [[ "$IS_ODIN3" == 1 ]]; then
    GAMESCOPE_ARGS+=(--force-composition-rotation --force-composition)
  else
    GAMESCOPE_ARGS+=(--use-rotation-shader --force-composition)
  fi
fi
if [[ -n "$PANEL_ORIENT" ]]; then
  GAMESCOPE_ARGS+=(--force-orientation "$PANEL_ORIENT")
fi
if [[ "$MANGOAPP" == 1 ]]; then
  GAMESCOPE_ARGS+=(--mangoapp)
fi

  if [[ -f /usr/share/holo/holo-cursor.png ]]; then
  GAMESCOPE_ARGS+=(--cursor /usr/share/holo/holo-cursor.png --cursor-scale-height 720)
fi

if [[ "${GAMESCOPE_SESSION_TARGET}" != "gamescope-session.target" ]]; then
  WATCH_SERVICE="steamvr-nested-desktop.service"
fi

# mangoapp sizes its text in pixels for the Deck's 800 lines, so on the
# tablets (1904 lines on the Legion Y700 Gen 4) the performance overlay was
# a sliver in the corner. Scale it to the panel; read_cfg keeps Steam's
# preset file (MANGOHUD_CONFIGFILE) in use, which MANGOHUD_CONFIG alone skips.
if [[ "$MANGOAPP" == 1 && -z "${MANGOHUD_CONFIG:-}" && "$H" -gt 1200 ]]; then
  MANGOHUD_CONFIG="read_cfg,font_scale=$(awk -v h="$H" 'BEGIN { printf "%.1f", h / 800 }')"
  export MANGOHUD_CONFIG
fi

# Steam (steam.service) does not inherit this script's environment, and the
# gamescope-onready import races Steam's start: Steam then has no refresh-rate
# slider (only 144/n frame limits) and no STEAM_USE_MANGOAPP. Hand the Steam
# session vars over through a file steam.service reads at start.
env | grep -E '^(STEAM_DISPLAY_REFRESH_LIMITS|STEAM_USE_MANGOAPP|STEAM_MANGOAPP_[A-Z_]+|STEAM_DISABLE_MANGOAPP_ATOM_WORKAROUND|GAMESCOPE_MANGOAPP_SOCKET_DISABLE|MANGOHUD_CONFIGFILE|MANGOHUD_CONFIG)=' \
  >"$XDG_RUNTIME_DIR/gamescope-steam.env" 2>/dev/null || true

echo >&2 "gamescope-session: output=$OUTPUT panel=${PANEL_W}x${PANEL_H} nested=${W}x${H}@${REFRESH_HZ} max=${MAX_HZ} mangoapp=${MANGOAPP} kms_rotation=${KMS_ROTATION} ignore_touch=${GAMESCOPE_IGNORE_TOUCH:-} bottom=${GAMESCOPE_LEASE_CONNECTOR:-none} orientation=${PANEL_ORIENT:-auto}"

exec gamescope "${GAMESCOPE_ARGS[@]}" -- /usr/lib/steamos/gamescope-onready ${WATCH_SERVICE:-}
