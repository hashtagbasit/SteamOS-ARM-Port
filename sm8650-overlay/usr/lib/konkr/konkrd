# The Adreno 740 GMU can wedge when a GPU interrupt wakes one of the little
# cores out of power collapse (found by ArmadaOS). The kernel boots with
# ROCKNIX's irqaffinity (little cores), so only the GPU/GMU interrupts move
# to the big cores, after boot. SM8550 only; the Pocket FIT's A750 is fine.
GPU_IRQ_NAMES = ("gpu", "gmu", "hfi", "adreno", "kgsl")


def cpu_list(text: str) -> set[int]:
    out: set[int] = set()
    for part in text.split(","):
        a, _, b = part.strip().partition("-")
        if a.isdigit():
            out.update(range(int(a), int(b or a) + 1))
    return out


def pin_gpu_irqs() -> None:
    try:
        if b"qcom,sm8550" not in open("/proc/device-tree/compatible", "rb").read():
            return
    except OSError:
        return
    big = big_cpus()
    if not big:
        return
    want = ",".join(str(c) for c in sorted(big))
    try:
        lines = open("/proc/interrupts", encoding="utf-8").read().splitlines()
    except OSError:
        return
    for line in lines[1:]:
        irq, _, rest = line.partition(":")
        irq = irq.strip()
        if not irq.isdigit() or not any(n in rest.lower() for n in GPU_IRQ_NAMES):
            continue
        path = f"/proc/irq/{irq}/smp_affinity_list"
        cur = rd(path)
        if cur and cpu_list(cur) != big and wr(path, want):
            log(f"gpu irq {irq} -> cpus {want}")


def ensure_webhelper_vulkan() -> None:
    """Re-apply the ANGLE-Vulkan flags if a Steam client update rewrote the
    launcher (Steam restarts the UI on its own after updates)."""
    s = rd(WEBHELPER_SH)
    if not s or "DISABLE_GAMESCOPE_WSI=1 exec" in s:
        return
    if "KONKR_CEF_FLAGS" in s and KONKR_CEF_OLD_EXEC in s:
        new = s.replace(KONKR_CEF_OLD_EXEC, "DISABLE_GAMESCOPE_WSI=1 " + KONKR_CEF_OLD_EXEC)
    elif WEBHELPER_EXEC in s and "KONKR_CEF_FLAGS" not in s:
        new = s.replace(WEBHELPER_EXEC, KONKR_CEF)
    else:
        return
    try:
        tmp = WEBHELPER_SH + ".tmp"
        with open(tmp, "w", encoding="utf-8") as fh:
            fh.write(new + ("" if new.endswith("\n") else "\n"))
        st = os.stat(WEBHELPER_SH)
        os.chown(tmp, st.st_uid, st.st_gid)
        os.chmod(tmp, st.st_mode)
        os.replace(tmp, WEBHELPER_SH)
        log("steamwebhelper.sh: re-applied ANGLE-Vulkan UI flags")
    except OSError as exc:
        log(f"steamwebhelper.sh: {exc}")


# ----------------------------------------------------------------- leds ----
def led(pattern: str) -> str | None:
    for d in glob.glob(f"/sys/class/leds/*{pattern}*"):
        if os.path.exists(f"{d}/multi_intensity"):
            return d
    return None


def led_rgb(d: str | None, rgb, brightness: int = 255) -> None:
    if not d:
        return
    # multi_intensity follows the LED's own channel order (multi_index). The
    # KONKR LEDs list red green blue, the AYN stick zones blue green red, so
    # writing r g b as is turned red blue and yellow cyan on the Thor and RP6.
    order = rd(f"{d}/multi_index").split()
    names = {"red": 0, "green": 1, "blue": 2}
    if sorted(order) == ["blue", "green", "red"]:
        rgb = [rgb[names[c]] for c in order]
    wr(f"{d}/multi_intensity", " ".join(str(c) for c in rgb))
    wr(f"{d}/brightness", brightness)


def stick_leds() -> list[str]:
    """The stick lights as multicolor LEDs: one for both sticks (KONKR
    konkr:rgb:joysticks), one per side (AYN Odin 2: left-/right-joystick) or
    one per zone (Thor, Odin 2 Portal, RP6: rgb:l1-l4 and rgb:r1-r4)."""
    one = led("joysticks")
    if one:
        return [one]
    out = []
    for d in sorted(glob.glob("/sys/class/leds/*")):
        n = os.path.basename(d)
        zone = n.startswith("rgb:") and n[4:5] in ("l", "r") and n[5:].isdigit()
        if (zone or n in ("left-joystick", "right-joystick")) and os.path.exists(f"{d}/multi_intensity"):
            out.append(d)
    return out


def battery() -> tuple[int, str]:
    for b in glob.glob("/sys/class/power_supply/*"):
        if rd(f"{b}/type") == "Battery":
            try:
                return int(rd(f"{b}/capacity", "0")), rd(f"{b}/status")
            except ValueError:
                pass
    return -1, ""


def stick_rgb(cfg: dict) -> tuple[int, int, int]:
    color = cfg.get("color", "ff3c00")
    if not isinstance(color, str) or len(color) != 6 or any(c not in "0123456789abcdefABCDEF" for c in color):
        color = "ff3c00"
    return tuple(int(color[i:i + 2], 16) for i in (0, 2, 4))


def stick_position(d: str, sticks: list[str]) -> float:
    """Where a stick light sits for the rainbow, 0-1: the zones round each
    ring (rgb:l1-l4), or one light per side half a turn apart."""
    n = os.path.basename(d)
    if n.startswith("rgb:"):
        side = [s for s in sticks if os.path.basename(s)[4:5] == n[4:5]]
        return (int(n[5:]) - 1) / max(1, len(side))
    return 0.5 if n.startswith("right") else 0.0


class Leds:
    # Effects: "breath" pulses one colour, "chroma" takes every light through
    # the hues together, "rainbow" spreads the hues round the rings and turns
    # them. The AYN stick lights are drawn here, ANIM_STEP_S apart, at the
    # state's speed (0-100). The KONKR single LED sends a UART frame to the
    # MCU on every write, so it runs the MCU's own effects instead: its breath,
    # and its hue cycle as chroma, at the firmware's one speed.
    ANIM_MODES = ("breath", "chroma", "rainbow")
    MCU_EFFECTS = {"breath": "breath", "chroma": "rainbow"}
    LIVE_MODES = ("battery", "heat")
    ANIM_STEP_S = 0.1
    # Seconds per cycle at speed 0 and at speed 100.
    PERIODS = {"breath": (8.0, 1.0), "chroma": (30.0, 2.0), "rainbow": (12.0, 1.0)}

    def __init__(self):
        self.power = led("power-led")
        self.sticks = stick_leds()
        self.mcu = len(self.sticks) == 1 and os.path.exists(f"{self.sticks[0]}/effect")
        self.positions = {d: stick_position(d, self.sticks) for d in self.sticks}
        self.flash_until = 0.0
        self.pulse = False
        self.phase = 0.0
        self.last_anim = 0.0
        self.last_frame: dict[str, tuple] = {}

    def modes(self) -> tuple[str, ...]:
        """The effects these stick lights can show (and off)."""
        if not self.sticks:
            return ()
        if self.mcu:
            return ("static", *self.MCU_EFFECTS, *self.LIVE_MODES, "off")
        if len(self.sticks) == 1:      # one light, no effect attr: plain colour
            return ("static", *self.LIVE_MODES, "off")
        return ("static", *self.ANIM_MODES, *self.LIVE_MODES, "off")

    def animating(self, st: dict) -> bool:
        return not self.mcu and len(self.sticks) > 1 and st["rgb"].get("mode") in self.ANIM_MODES

    @classmethod
    def period(cls, mode: str, speed) -> float:
        slow, fast = cls.PERIODS[mode]
        try:
            s = max(0, min(100, int(speed))) / 100
        except (TypeError, ValueError):
            s = 0.5
        return slow * (fast / slow) ** s

    def animate(self, st: dict, now: float) -> None:
        dt = now - self.last_anim
        if dt < self.ANIM_STEP_S:
            return
        self.last_anim = now
        cfg = st["rgb"]
        mode = cfg.get("mode")
        # The phase advances by elapsed time, so a speed change doesn't jump.
        self.phase = (self.phase + min(dt, 1.0) / self.period(mode, cfg.get("speed", 50))) % 1.0
        bright = max(0, min(255, int(cfg.get("brightness", 160))))
        for d in self.sticks:
            if mode == "breath":
                # 0.06 floor so the light never goes fully dark mid-cycle.
                level = 0.06 + 0.94 * (0.5 - 0.5 * math.cos(2 * math.pi * self.phase))
                frame = (stick_rgb(cfg), int(round(bright * level)))
            else:
                hue = (self.phase + (self.positions[d] if mode == "rainbow" else 0.0)) % 1.0
                frame = (tuple(int(round(c * 255)) for c in colorsys.hsv_to_rgb(hue, 1.0, 1.0)), bright)
            if self.last_frame.get(d) != frame:
                self.last_frame[d] = frame
                led_rgb(d, *frame)

    def flash(self, rgb) -> None:
        led_rgb(self.power, rgb, 255)
        self.flash_until = time.monotonic() + 2.0

    def tick(self, enabled: bool = True, mode: str = "charge", profile: str = "balanced") -> None:
        """mode "charge": amber charging, green full, off otherwise. "profile":
        the performance profile's colour all the time. Either way a low
        battery pulses red."""
        if not self.power or time.monotonic() < self.flash_until:
            return
        if not enabled or os.path.exists(STANDBY_FLAG):
            wr(f"{self.power}/brightness", 0)
            return
        cap, status = battery()
        if 0 <= cap < 15 and status != "Charging":
            self.pulse = not self.pulse
            led_rgb(self.power, (255, 0, 0), 60 if self.pulse else 0)
        elif mode == "profile":
            led_rgb(self.power, PROFILE_RGB.get(profile, PROFILE_RGB["balanced"]), 40)
        elif status == "Charging":
            led_rgb(self.power, (255, 120, 0), 40)
        elif status == "Full" or (status == "Not charging" and cap >= 99):
            led_rgb(self.power, (0, 255, 0), 30)
        else:
            wr(f"{self.power}/brightness", 0)

    @staticmethod
    def _blend(stops: list[tuple[float, tuple[int, int, int]]], x: float) -> tuple[int, int, int]:
        """Colour at x along stops [(position, rgb), ...]."""
        if x <= stops[0][0]:
            return stops[0][1]
        for (p0, c0), (p1, c1) in zip(stops, stops[1:]):
            if x <= p1:
                t = (x - p0) / (p1 - p0)
                return tuple(round(a + (b - a) * t) for a, b in zip(c0, c1))
        return stops[-1][1]

    def live_color(self, mode: str) -> tuple[int, int, int] | None:
        """Colours that follow the device: battery charge (red when low,
        green when full) or chip temperature (blue cool, red hot)."""
        if mode == "battery":
            pct, _ = battery()
            if pct < 0:
                return None
            return self._blend([(10, (255, 20, 0)), (40, (255, 150, 0)), (80, (40, 255, 60))], pct)
        if mode == "heat":
            try:
                t = soc_temp_c()
            except RuntimeError:
                return None
            return self._blend([(40, (0, 120, 255)), (60, (255, 170, 0)), (80, (255, 20, 0))], t)
        return None

    def apply_sticks(self, st: dict) -> None:
        cfg = st["rgb"]
        mode = cfg.get("mode", "static")
        rgb = stick_rgb(cfg)
        live = self.live_color(mode)
        if live is not None:
            rgb = live
        self.shown_rgb = (mode, rgb)
        self.last_frame.clear()
        if self.animating(st):
            self.last_anim = 0.0
            self.animate(st, time.monotonic())
            return
        bright = max(0, min(255, int(cfg.get("brightness", 160))))
        for d in self.sticks:
            if mode == "off":
                wr(f"{d}/brightness", 0)
                continue
            eff = f"{d}/effect"
            if self.mcu and mode in self.MCU_EFFECTS:
                if self.MCU_EFFECTS[mode] == "breath":
                    # Effect arguments reach the MCU unscaled by brightness.
                    wr(eff, "breath {} {} {}".format(*(round(c * bright / 255) for c in rgb)))
                else:
                    wr(eff, self.MCU_EFFECTS[mode])
                continue
            if os.path.exists(eff):
                wr(eff, "static")
            led_rgb(d, rgb, bright)


