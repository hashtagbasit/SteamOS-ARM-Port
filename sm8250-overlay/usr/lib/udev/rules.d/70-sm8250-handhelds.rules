# SM8250 (865) handhelds.

# The built-in pads are joysticks for SDL / Steam, and readable by the
# session (InputPlumber takes them over in Game Mode).
SUBSYSTEM=="input", ATTRS{name}=="Retroid Pocket Gamepad", MODE="0666", ENV{ID_INPUT_JOYSTICK}="1"
SUBSYSTEM=="input", ATTRS{name}=="MANGMI Pocket Max Joypad", MODE="0666", ENV{ID_INPUT_JOYSTICK}="1"
SUBSYSTEM=="input", ATTRS{name}=="MANGMI Air Y Pro Joypad", MODE="0666", ENV{ID_INPUT_JOYSTICK}="1"

# Rumble motor (PMI8998 haptics) for the logged-in user.
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="pmi8998_haptics", TAG+="uaccess", ENV{FEEDBACKD_TYPE}="vibra"

# WCD938x headset codec (SoundWire part 0217:010d): runtime suspend loses
# the headphone jack detection. Keep it powered.
ACTION=="bind", SUBSYSTEM=="soundwire", KERNEL=="sdw:*:0217:010d:*", ATTR{power/control}="on"

# WSA881x speaker amps (0217:2010). The MANGMI Pocket Max powers both down
# with one shared GPIO, so one amp runtime-suspending holds the other in
# powerdown, it never finishes SoundWire enumeration and the card fails
# (-110). Keep both up from bind. Harmless on the boards with separate lines.
ACTION=="bind", SUBSYSTEM=="soundwire", KERNEL=="sdw:*:0217:2010:*", ATTR{power/control}="on"

# MANGMI Pocket Max: the audio codec's runtime suspend pops in the headphones.
# Keep it powered (from ArmadaOS 992a4ec / 678333b).
ACTION=="bind", SUBSYSTEM=="platform", KERNEL=="audio-codec", PROGRAM="/usr/bin/grep -q 'MANGMI Pocket Max' /sys/firmware/devicetree/base/model", ATTR{power/control}="on"
