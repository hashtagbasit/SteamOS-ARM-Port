# SM8550 (Snapdragon 8 Gen 2): AYN Odin 2 / Mini / Portal / Thor, AYANEO
# Pocket ACE / DMG / DS / EVO / S 1K / S 2K, Retroid Pocket 6 / Nova.
# Sourced by kernel-common/build.sh and kernel-common/cmdline.sh.

SOC=sm8550
ROCKNIX_DEVICE=SM8550

# Same ROCKNIX release as SM8650 (tag 20260801: Linux 7.1.2), which ships
# SM8550 images for all of these devices.
KVER=7.1.2
ROCKNIX_REF=20260801
EXTRA_FW_REF=88b363e67d4f730feb2c3124724d26dfaa88ce76
# Adreno 740 microcode + zap come from upstream linux-firmware, same files
# ROCKNIX lists in devices/SM8550/config/kernel-firmware.dat.
LINUX_FW_REF=20260916

# ROCKNIX's PKG_PATCH_DIRS for SM8550 on 7.1.2: mainline, device, default, 7.0.
PATCH_DIRS="projects/ROCKNIX/packages/linux/patches/mainline projects/ROCKNIX/devices/SM8550/patches/linux packages/linux/patches/default projects/ROCKNIX/packages/linux/patches/7.0"

# ROCKNIX patches to leave out, replaced by ours in patches/: 0121's newer
# version floors the GPU (GMU) rails low before sync_state instead of only
# dropping the max clamp. Our kernel died ~2 s after reaching the root, right
# when the GPU powers up, and the newer one is what boots RP6/Thor elsewhere.
# 0008 (iommu-map by #iommu-cells) is for 7.2's 5-word entries; 7.1.2's
# device tree still has 4-word ones.
PATCH_SKIP="0121-pmdomain-qcom-rpmhpd-no-max-clamp-on-gmu-rails.patch 0008-pci-qcom-of-iommu-map-entries-by-iommu-cells.patch 0010-drm-msm-dsi-phy-7nm-program-pll-muxes-on-phy-enable.patch 0011-drm-panel-ch13726a-thor-16-bit-brightness.patch 0012-drm-msm-map-submitqueue-priority-in-order.patch 0013-wifi-ath12k-send-the-computed-scan-priority.patch 0014-thermal-qcom-tsens-mask-lower-threshold-irqs-across-suspend.patch 0015-soc-qcom-ice-unwind-clocks-on-resume-failure.patch 0016-scsi-ufs-qcom-reenable-irq-on-host-reset-failure.patch 0017-PCI-qcom-skip-L23-ready-poll-on-SM8550.patch 0018-PCI-qcom-honour-an-opp-suspend-opp-as-the-non-s2ram-memory-floor.patch 0019-arm64-dts-qcom-sm8550-add-a-pcie-suspend-opp.patch 0020-PCI-host-common-let-only-endpoints-veto-d3cold.patch 0021-regulator-qcom-rpmh-add-suspend-state-support.patch 0022-regulator-core-apply-mem-state-for-s2idle.patch 0023-regulator-core-log-missing-suspend-configuration-at-debug.patch 0024-regulator-apply-state-mem-in-s2idle-only-for-opted-in-drivers.patch 0025-ASoC-qcom-sc8280xp-suspend-the-card-and-its-streams.patch 0026-ASoC-qdsp6-q6apm-fail-the-graph-open-when-the-DSP-rejects-it.patch 0027-ASoC-qdsp6-release-AudioReach-graphs-across-system-suspend.patch 0028-tty-serial-qcom-geni-mask-non-console-irq-on-suspend.patch 0029-input-rsinput-power-the-mcu-down-across-system-sleep.patch 0030-input-edt-ft5x06-thor-release-contacts-a-frame-leaves-out.patch 0032-wifi-ath12k-convert-scan-timeout-to-wiphy-delayed-work.patch 0033-scsi-ufs-qcom-keep-lane-clock-enables-balanced.patch 0034-tty-serial-qcom-geni-release-cx-votes-across-system-suspend.patch 0035-drm-msm-let-cpu-prep-wait-for-bookkeeping-fences.patch 0036-media-iris-decode-order-output-control.patch 0037-power-supply-qcom-battmgr-power-and-time-to-full.patch 0038-drm-panel-il97680a-display-on-in-enable.patch 0039-arm64-emulate-unaligned-atomics.patch 0040-arm64-unaligned-atomics-fixup-for-the-load128-write-back.patch 0041-drm-msm-dp-dont-fail-audio-prepare-when-display-off.patch 0042-input-qcom-hv-haptics-stop-at-zero-amplitude-right-away.patch 0043-input-rsinput-measure-triggers-from-the-fixed-rest-level.patch 0044-ASoC-wcd93xx-failed-zdet-ramp-is-a-floating-reading.patch 0045-drm-msm-dpu-optional-dithering-for-8bpc-dsi-panels.patch 0046-ASoC-wcd-mbhc-clear-stale-jack-report-on-mechanical-removal.patch 0047-drm-msm-signal-hw_done-before-the-flip-event.patch 0048-drm-msm-dpu-fix-inline-rotation.patch 0049-drm-msm-dpu-enable-sm8550-inline-rotation.patch 0050-drm-msm-dpu-enable-qseed-detail-enhancer.patch 0051-drm-panel-icna35xx-cap-the-backlight-below-the-boost-range.patch 0053-drm-msm-a6xx-preserve-hfi-response-bits.patch 0054-drm-msm-a6xx-bound-fault-coredump-waits.patch 0055-drm-msm-a6xx-mask-hfi-before-gmu-boot.patch 0056-usb-xhci-pci-renesas-restore-firmware-on-resume.patch"

# SM8550_RECIPE=7.2: ROCKNIX's 7.2 recipe (tag 20260901) on 7.2.8, the test
# kernel for moving off 7.1.2. Build it with GCC 15 (build-gcc15.sh): 7.2
# built with Ubuntu's GCC 13 is reported to die before the initramfs.
# ROCKNIX 20260901 already has the presync GMU floor (their new 0121) and the
# haptics __assign_str fix, and 7.2.8 has the a6xx stale rpmh fix, so only
# our rsinput patches are left on top. PATCH_SKIP matches our patches too.
if [[ "${SM8550_RECIPE:-7.1}" == 7.2 ]]; then
  KVER=7.2.8
  ROCKNIX_REF=20260901
  EXTRA_FW_REF=2b7207cfcb80c53c09dc6e04165789ecaf2d3348
  # ROCKNIX's order for 7.2: version dir, mainline, device, default.
  PATCH_DIRS="projects/ROCKNIX/packages/linux/patches/7.2 projects/ROCKNIX/packages/linux/patches/mainline projects/ROCKNIX/devices/SM8550/patches/linux packages/linux/patches/default"
  # 9999 renames perf's Rust targets for ROCKNIX's toolchain; we don't build perf.
  PATCH_SKIP="9999-fix-rust-build-error.patch 0001-input-qcom-hv-haptics-one-argument-assign-str.patch 0002-pmdomain-qcom-rpmhpd-presync-floor-gmu-rails.patch 0003-drm-msm-a6xx-fix-stale-rpmh-votes-after-suspend.patch"
fi

DTBS="qcs8550-ayaneo-pocketace qcs8550-ayaneo-pocketdmg qcs8550-ayaneo-pocketds qcs8550-ayaneo-pocketevo qcs8550-ayaneo-pockets1k qcs8550-ayaneo-pockets2k qcs8550-ayn-odin2 qcs8550-ayn-odin2mini qcs8550-ayn-odin2portal qcs8550-ayn-thor qcs8550-retroidpocket-rp6 qcs8550-retroidpocket-rp6-top-dpad qcs8550-retroidpocket-rpnova"

# lfw/ = upstream linux-firmware at LINUX_FW_REF. Installed to the rootfs
# only: ROCKNIX's SM8550 kernel has no built-in firmware and loads the GPU
# microcode once the root is mounted.
FW_BUILTIN=0
BUILTIN_FW="
lfw/qcom/a740_sqe.fw:qcom/a740_sqe.fw
lfw/qcom/gmu_gen70200.bin:qcom/gmu_gen70200.bin
lfw/qcom/sm8550/a740_zap.mbn:qcom/sm8550/a740_zap.mbn
"

if [[ "${SM8550_RECIPE:-7.1}" == 7.2 ]]; then
  # Beta 7's Wi-Fi firmware (the Frame's WCN7850 set) built into the kernel:
  # built-in firmware wins over files on the card, so the Wi-Fi works even
  # on a card that still has beta 8's upstream set (no board entry for the
  # Odin 2 / Thor: "qmi failed to load board data"). regulatory.db comes
  # along with FW_BUILTIN=1. The GPU firmware still loads from the card.
  FW_BUILTIN=1
  BUILTIN_FW="
frm/wcn7850-frame/amss.bin:ath12k/WCN7850/hw2.0/amss.bin:5660a1aa3db12716b42c687b0c88ef4f6ac80bd46e42cfe3636ed332d3f6e6ee
frm/wcn7850-frame/m3.bin:ath12k/WCN7850/hw2.0/m3.bin:ff40c57556c2fac552ac192c6e2ad59689fd8f50c9f9bcc997d13623c2bcee86
frm/wcn7850-frame/board-2.bin:ath12k/WCN7850/hw2.0/board-2.bin:8cc9a64baf68681ece5e26a8445630749eccbfb4517bdbf6802856787afa7c2d
"
fi

# ROCKNIX's SM8550 cmdline (devices/SM8550/options, 20260801), which is what
# boots these devices with this exact kernel. The Adreno 740 GMU can wedge
# when a GPU interrupt wakes CPU 0-2 out of power collapse (ArmadaOS), so
# konkrd moves only the GPU interrupts to the big cores after boot, like
# ArmadaOS does, instead of an irqaffinity= that neither reference boots with.
# mem_sleep_default=s2idle: same as the Pocket FIT.
# Which kernel the SM8550 image ships (make-steamos-sm8650.sh):
#   prebuilt = a prebuilt 7.0.14-edge-sm8550 KERNEL + its modules and
#             firmware, taken from a released SM8550 SteamOS image
#             (scripts/import-sm8550-kernel.sh). Boots the Odin 2 / Mini /
#             Thor / RP6 there, and our
#             rootfs ran on it for 5 min on an Odin 2 Mini (display only
#             missing because its modules were not on the card).
#   rocknix = our ROCKNIX 7.1.2 build below. Starts and reaches the root, but
#             the device dies within ~2 s of handover, before any log.
SM8550_KERNEL="${SM8550_KERNEL:-prebuilt}"

# ROCKNIX kernel cmdline:
# pcie_aspm=off: on the Pocket EVO (7.2.8, beta 8) the Wi-Fi's PCIe link
# dropped after ~90 s ("Device link is not accessible", MHI never ready) with
# L0s/L1 on, and the Renesas USB controller that carries the AYANEO gamepad
# stalled right after it was enabled. The prebuilt kernel already runs with it.
# fw_devlink.sync_state=timeout: see kernel-sm8650/soc.env (clock controllers
# waiting forever for driverless consumers kept their boot votes).
CMDLINE_SOC_ROCKNIX="fw_devlink.sync_state=timeout allow_mismatched_32bit_el0 fw_devlink.strict=1 pcie_ports=compat irqaffinity=0-2 cgroup.memory=nokmem,nosocket nosoftlockup usbcore.interrupt_interval_override=045e:028e:2 mem_sleep_default=s2idle pcie_aspm=off"
# That kernel's own flags (from its KERNEL header), plus s2idle: without it a suspend
# goes to "deep", which never wakes on these chips (RP6: power tap looked
# like power-off, only a 10 s hold brought it back). ROCKNIX and Armada both
# run s2idle here too.
# pcie_aspm=off: the AYANEO Pockets lose 27 s every boot to a PCIe USB
# controller timing out (xhci 0001:01:00.0, -110) with link power saving on.
CMDLINE_SOC_PREBUILT="clk_ignore_unused pd_ignore_unused mem_sleep_default=s2idle pcie_aspm=off"
if [[ "$SM8550_KERNEL" == prebuilt ]]; then
  CMDLINE_SOC="$CMDLINE_SOC_PREBUILT"
else
  CMDLINE_SOC="$CMDLINE_SOC_ROCKNIX"
fi

# Boot image: packed like ROCKNIX's SM8550 KERNEL (linux/package.mk):
# everything at the base address, a dummy ramdisk, and the initramfs built
# into the kernel Image. As a real bootimg ramdisk (betas 1 and 2, at the
# base and at the separate addresses) it never ran on any device: no bootlog.txt.
EMBED_INITRAMFS=1
