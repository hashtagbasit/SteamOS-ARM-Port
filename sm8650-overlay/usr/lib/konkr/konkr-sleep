#!/bin/bash
# konkr-sleep pre|post — make kernel s2idle safe on the KONKR Pocket FIT.
#
# Run by konkr-sleep.service (Before=sleep.target), i.e. before systemd-sleep
# freezes user.slice, so PipeWire can still be told to close its ALSA devices.
#
# What broke s2idle before (journal, 2026-09-23):
#   - hang on entry right after ath12k/wlan0 teardown  -> unload ath12k first
#     (Valve does the same for ath11k on the Deck: system-sleep/modules-reload.sh)
#   - chipone touch IRQ firing into a suspended I2C bus (-110 timeouts)
#                                                      -> unbind it for the sleep
#   - audio dead after resume (soundwire clock-stop / APM timeouts with a
#     stream still open)                               -> suspend all sinks/sources
#   - battery / USB-C / Wi-Fi / DSP / USB-host events are wake sources
#                                                      -> only the power key wakes
set -u

TOUCH_DRV=/sys/bus/i2c/drivers/chipone-tddi
WIFI_MODS=(ath12k_wifi7 ath12k)
UID_STEAM=1000

log() { echo "konkr-sleep: $*"; }

# Preserve the last reached stage in debug mode: a watchdog reboot can lose
# the journal tail, and the boot collector stops taking journals after 3 min.
# Use uptime so clock corrections do not confuse slow pre/post diagnostics.
step() {
  local rc message
  message="stage=$* begin uptime=$(cut -d' ' -f1 /proc/uptime)"
  log "$message" >&2
  sleep_debug "$message"
  "$@"
  rc=$?
  message="stage=$* end rc=$rc uptime=$(cut -d' ' -f1 /proc/uptime)"
  log "$message" >&2
  sleep_debug "$message"
  return "$rc"
}

sleep_debug() {
  [[ -e /boot/debug ]] || return 0
  mountpoint -q /boot || return 0
  mkdir -p /boot/debug-logs 2>/dev/null || return 0
  printf '%s\n' "$*" >>/boot/debug-logs/sleep-stages.txt
  # Flush asynchronously so diagnostics do not add a delay at every stage.
  # Only testers with BOOT/debug use it; a failing SD cannot block this hook.
  timeout 1 sync /boot/debug-logs/sleep-stages.txt >/dev/null 2>&1 &
}

as_user() {
  local user
  user=$(id -nu "$UID_STEAM" 2>/dev/null) || return 0
  [[ -S /run/user/$UID_STEAM/pulse/native ]] || return 0
  timeout 3 runuser -u "$user" -- env XDG_RUNTIME_DIR=/run/user/$UID_STEAM "$@" 2>/dev/null
}

audio() {  # audio 1 = suspend, 0 = resume
  local kind name
  for kind in sinks sources; do
    as_user pactl list short "$kind" | while read -r _ name _; do
      [[ $name == *.monitor ]] && continue
      as_user pactl "suspend-${kind%s}" "$name" "$1"
    done
  done
}

gamescope_screen() {  # 1 = panel off (DPMS, not just backlight), 0 = on
  # Every running gamescope, not only Game Mode's: on the Thor and Pocket DS
  # the bottom panel belongs to a second gamescope on a DRM lease, and with
  # only gamescope-0 told, the bottom screen stayed black after standby.
  local sock name
  for sock in /run/user/$UID_STEAM/gamescope-*; do
    name=${sock##*/}
    [[ -S $sock && $name != *.lock ]] || continue
    # A dead compositor leaves its socket behind; only a live one holds the lock.
    flock -n "$sock.lock" true 2>/dev/null && continue
    timeout 3 runuser -u "$(id -nu "$UID_STEAM")" -- env XDG_RUNTIME_DIR=/run/user/$UID_STEAM \
      GAMESCOPE_WAYLAND_DISPLAY="$name" gamescopectl drm_sleep_internal_screen "$1" >/dev/null 2>&1
  done
}

wake_sources() {
  local w dev
  for w in /sys/devices/platform/pmic-glink/*/power_supply/*/power/wakeup \
           /sys/bus/mhi/devices/mhi*/power/wakeup \
           /sys/bus/pci/devices/*/power/wakeup \
           /sys/devices/platform/soc@0/*.remoteproc/power/wakeup; do
    [[ -w $w ]] || continue
    echo disabled >"$w" 2>/dev/null
  done
  # keep: pmic pwrkey (power button), gpio-keys
  for dev in /sys/devices/platform/soc@0/*.spmi/spmi-0/*/*pon*/*pwrkey /sys/devices/platform/gpio-keys; do
    [[ -w $dev/power/wakeup ]] && echo enabled >"$dev/power/wakeup"
  done
}

touch_off() {
  local d n=0
  if [[ -d $TOUCH_DRV ]]; then
    for d in "$TOUCH_DRV"/[0-9]*-*; do
      [[ -e $d ]] || continue
      echo "${d##*/}" >"$TOUCH_DRV/unbind" 2>/dev/null && n=$((n + 1))
    done
  fi
  echo "$n"
}

battery_pct() {
  local b
  for b in /sys/class/power_supply/*; do
    [[ $(cat "$b/type" 2>/dev/null) == Battery ]] && { cat "$b/capacity" 2>/dev/null; return; }
  done
}

# One journal line per sleep, for s2idle reports:
#   journalctl -b | grep "s2idle report"
report_start() {
  mkdir -p /run/konkr
  echo "$(date +%s) $(battery_pct) $(cat /sys/power/suspend_stats/success 2>/dev/null) $(cat /sys/power/suspend_stats/fail 2>/dev/null)" >/run/konkr/sleep-start
}

report_end() {
  local t0 b0 ok0 fail0 t1 b1 ok1 fail1 irq name h
  read -r t0 b0 ok0 fail0 </run/konkr/sleep-start 2>/dev/null || return 0
  t1=$(date +%s); b1=$(battery_pct)
  ok1=$(cat /sys/power/suspend_stats/success 2>/dev/null); fail1=$(cat /sys/power/suspend_stats/fail 2>/dev/null)
  irq=$(cat /sys/power/pm_wakeup_irq 2>/dev/null)
  [[ -n $irq ]] && name=$(awk -v i="$irq:" '$1 == i {for (n = NF; n > 1; n--) if ($n !~ /^[0-9]+$/) {print $n; exit}}' /proc/interrupts)
  h=$(awk -v s=$((t1 - t0)) 'BEGIN {printf "%.2f", s / 3600}')
  log "s2idle report: ${h} h, battery ${b0}% -> ${b1}%, suspends ok $((ok1 - ok0)) failed $((fail1 - fail0)), woken by irq ${irq:-?} ${name:-}, last failed step $(cat /sys/power/suspend_stats/last_failed_step 2>/dev/null) $(cat /sys/power/suspend_stats/last_failed_dev 2>/dev/null)"
  rm -f /run/konkr/sleep-start
}

# Running from the SD card, the internal UFS is idle, but after a long s2idle
# sleep its PHY can fail to come back, the host stays in error and every later
# suspend aborts with -EBUSY until a reboot. So it sleeps unbound: off before
# suspend, bound again (a fresh init, not a resume) after. Left alone whenever
# anything on it is mounted, swapped to or held (an internal install).
UFS_STATE=/run/konkr/ufs-unbound
pocket_evo() {
  tr '\0' '\n' </proc/device-tree/compatible 2>/dev/null | grep -qx 'ayaneo,pocketevo'
}

# Pocket EVO (G3x Gen 2 / SM8550) must keep its UFS driver bound. The
# captured failed sleep stops inside ufs_off, before kernel suspend begins.
# The Pocket FIT detach workaround can block in a sysfs write on EVO; a
# timeout cannot recover a task stuck in uninterruptible kernel I/O. Let
# ufshcd's PM callbacks handle it, as Armada does, on SD and internal boots.
# Match the board, not Adreno 740/SM8550 shared by several other handhelds.
ufs_in_use() {  # $1 = ufshc platform device name
  local blk dev part
  for blk in /sys/block/sd*; do
    [[ $(readlink -f "$blk") == */"$1"/* ]] || continue
    dev=${blk##*/}
    for part in "$blk" "$blk/$dev"*; do
      [[ -e $part/dev ]] || continue
      grep -q "^/dev/${part##*/}[[:space:]]" /proc/mounts /proc/swaps && return 0
      [[ -n $(ls "$part/holders" 2>/dev/null) ]] && return 0
    done
  done
  return 1
}
ufs_off() {
  local host name
  if pocket_evo; then
    log "ufs: Pocket EVO uses kernel suspend/resume; leaving host bound" >&2
    return 0
  fi
  mkdir -p "${UFS_STATE%/*}"; : >"$UFS_STATE"
  for host in /sys/bus/platform/drivers/ufshcd-qcom/*.ufshc; do
    [[ -e $host ]] || continue
    name=${host##*/}
    ufs_in_use "$name" && continue
    # Clock scaling off first: removing the host stops its devfreq monitor, and
    # with scaling on that stop deadlocked (the unbind stuck in D state, every
    # later suspend -EBUSY at freeze, shutdown hung). Off, the monitor is
    # already idle. A fresh bind turns scaling back on.
    [[ -w $host/clkscale_enable ]] && echo 0 >"$host/clkscale_enable"
    echo "$name" >/sys/bus/platform/drivers/ufshcd-qcom/unbind && echo "$name" >>"$UFS_STATE"
  done
  [[ -s $UFS_STATE ]] && echo "$(tr '\n' ' ' <"$UFS_STATE")"
}
ufs_on() {
  local name
  pocket_evo && return 0
  [[ -s $UFS_STATE ]] || return 0
  while read -r name; do
    echo "$name" >/sys/bus/platform/drivers/ufshcd-qcom/bind 2>/dev/null || log "ufs: rebind $name failed"
  done <"$UFS_STATE"
  rm -f "$UFS_STATE"
}

# 8 Gen 3 on our 7.2 kernel: the kernel itself handles Wi-Fi, audio graphs,
# touch and the PMIC wake sources across s2idle (Armada's suspend series).
# Unloading ath12k and unbinding touch on top of that hung the Pocket FIT on
# the first sleep; with only the report and the UFS step it sleeps and wakes
# every time (2026-10-04). The full preparation stays for older kernels and
# the other chips, where the s2idle fixes are not in.
light() {
  tr '\0' '\n' </proc/device-tree/compatible 2>/dev/null | grep -qx 'qcom,sm8650' || return 1
  case "$(uname -r)" in 7.[2-9].*|7.[1-9][0-9].*|[89].*) return 0 ;; esac
  return 1
}

# Wi-Fi after waking: steamos-arm-wifi-wake (shared with the 8 Elite).
wifi_mark() { /usr/lib/steamos-arm/steamos-arm-wifi-wake mark; }
wifi_watch_start() { /usr/lib/steamos-arm/steamos-arm-wifi-wake start; }

pre() {
  local n u
  report_start
  step wifi_mark
  if light; then
    sync
    u=$(step ufs_off)
    log "pre: kernel handles the devices, ufs unbound=${u:-none}"
    return
  fi
  step audio 1
  wake_sources
  n=$(step touch_off)
  if [[ -d /sys/module/${WIFI_MODS[0]} ]]; then
    step timeout 15 modprobe -r "${WIFI_MODS[@]}" || log "ath12k unload failed"
  fi
  sync
  u=$(step ufs_off)
  log "pre: audio suspended, touch unbound=$n, wifi=$([[ -d /sys/module/${WIFI_MODS[0]} ]] && echo loaded || echo unloaded), ufs unbound=${u:-none}"
}

touch_devices() {  # chipone panels on any I2C bus, bound or not
  local d
  for d in /sys/bus/i2c/devices/*; do
    [[ -r $d/of_node/compatible ]] || continue
    tr '\0' '\n' <"$d/of_node/compatible" | grep -q '^chipone' && echo "${d##*/}"
  done
}

touch_on() {
  local d
  # Rebind by DT match, not a saved list: a pre without a post (or two pres)
  # must never leave the touchscreen detached.
  for d in $(touch_devices); do
    [[ -e /sys/bus/i2c/devices/$d/driver ]] || echo "$d" >"$TOUCH_DRV/bind" 2>/dev/null
  done
}

post() {
  report_end
  step ufs_on
  if light; then
    step wifi_watch_start
    systemctl kill -s HUP konkrd.service >/dev/null 2>&1
    log "post: restored"
    return
  fi
  step touch_on
  if [[ ! -d /sys/module/${WIFI_MODS[0]} ]]; then
    step timeout 15 modprobe "${WIFI_MODS[0]}" || log "ath12k reload failed"
  fi
  # Start the channel scan after the interface has been restored, rather than
  # spending all fast-scan attempts racing the module reload.
  step wifi_watch_start
  step audio 0
  # konkrd re-applies profile clocks/LEDs on SIGHUP
  systemctl kill -s HUP konkrd.service >/dev/null 2>&1
  log "post: restored"
}

case "${1:-}" in
  pre) pre ;;
  post) post ;;
  # konkr-standby (no kernel suspend): quiet audio + touch, keep Wi-Fi
  standby-pre)
    audio 1
    gamescope_screen 1
    # KONKR_STANDBY_KEEP_WIFI=1: testing over SSH (wake with SIGUSR1)
    [[ -z ${KONKR_STANDBY_KEEP_WIFI:-} && -d /sys/module/${WIFI_MODS[0]} ]] \
      && timeout 15 modprobe -r "${WIFI_MODS[@]}"
    # No touch unbind here: rebinding after a long standby left the chipone
    # panel in a ghost-touch storm (~4700 events/s) that crash-looped gamescope.
    log "standby: prepared" ;;
  # Resume order (konkr-standby): standby-audio-on while the apps are still
  # frozen (PipeWire kept running), then thaw, standby-screen-on, standby-post.
  standby-audio-on) audio 0 ;;
  standby-post)
    [[ -d /sys/module/${WIFI_MODS[0]} ]] || modprobe "${WIFI_MODS[0]}" ;;
  standby-screen-on) gamescope_screen 0 ;;
  wifi-watch) exec /usr/lib/steamos-arm/steamos-arm-wifi-wake watch ;;
  *) echo "usage: konkr-sleep pre|post|standby-pre|standby-audio-on|standby-post|standby-screen-on|wifi-watch" >&2; exit 2 ;;
esac
exit 0
