#!/usr/bin/env python3
"""konkr-standby — safe "sleep" for the KONKR Pocket FIT.

Kernel suspend (s2idle and deep) does not reliably resume on the 7.1.2 kernel:
the device looked powered off and needed a forced restart. Steam's Sleep goes
through logind → systemd-suspend.service, which the port overrides to run
this instead. It:

  - pauses the running game (SIGSTOP on the Steam-launched process tree),
  - suspends audio, detaches the touch panel, unloads Wi-Fi and has
    gamescope power the panel off (konkr-sleep standby-pre),
  - freezes the user session (Steam, gamescope, games, Android), so nothing
    in userspace wakes the CPUs. PipeWire, WirePlumber and D-Bus keep
    running (idle, outputs suspended): frozen along with the apps, PipeWire
    woke hours out of date and audio lagged and crackled for minutes,
  - turns the panel backlight and the LEDs off,
  - takes the big cores offline, drops the little ones to their lowest clock
    and caps the GPU,
  - blocks until the power button is pressed again (or SIGUSR1; for testing
    over SSH run it with KONKR_STANDBY_KEEP_WIFI=1), then restores it all: CPUs and audio first,
    then the apps, then the screen.

Steam sees a normal suspend/resume cycle (PrepareForSleep false → true →
false). Nothing enters kernel suspend, so there is nothing to fail to wake.
"""
from __future__ import annotations

import glob
import os
import pwd
import select
import signal
import struct
import sys
import time

FLAG = "/run/konkr-standby"
EV = struct.Struct("llHHi")
EV_KEY, KEY_POWER = 1, 116
EV_SW, SW_LID = 5, 0


def rd(p: str, d: str = "") -> str:
    try:
        with open(p, encoding="utf-8") as fh:
            return fh.read().strip()
    except OSError:
        return d


def wr(p: str, v) -> None:
    try:
        with open(p, "w", encoding="utf-8") as fh:
            fh.write(str(v))
    except OSError:
        pass


def wr_ok(p: str, v) -> bool:
    try:
        with open(p, "w", encoding="utf-8") as fh:
            fh.write(str(v))
        return True
    except OSError:
        return False


def run(*cmd: str) -> int:
    import subprocess
    try:
        return subprocess.run(cmd, check=False, timeout=20,
                              stdout=subprocess.DEVNULL).returncode
    except (OSError, subprocess.TimeoutExpired):
        return 1


def big_cpus() -> list[int]:
    """CPUs above the lowest capacity (the A520s stay online)."""
    caps = {}
    for c in glob.glob("/sys/devices/system/cpu/cpu[0-9]*"):
        n = int(os.path.basename(c)[3:])
        v = rd(f"{c}/cpu_capacity", "0")
        caps[n] = int(v) if v.isdigit() else 0
    if not caps:
        return []
    low = min(caps.values())
    big = sorted(n for n, v in caps.items() if v > low and n != 0)
    # SM8550 (Adreno 740): the GMU can wedge when its interrupt wakes CPU 0-2,
    # so konkrd pins the GPU/GMU IRQs to the big cores. Offlining all of them
    # would push those IRQs back onto the little cores and hang the device
    # in standby (RP6, beta 4). Keep the first big core online there, whatever
    # the cmdline's irqaffinity says (the 7.0.14 kernel boots without one).
    irq = irq_cpus()
    if big and (is_sm8550() or (irq and not (irq - set(big)))):
        big.remove(min(big) if is_sm8550() else min(irq))
    return big


def is_sm8550() -> bool:
    try:
        with open("/sys/firmware/devicetree/base/compatible", "rb") as f:
            return b"qcom,sm8550" in f.read()
    except OSError:
        return False


def irq_cpus() -> set[int]:
    try:
        mask = int(rd("/proc/irq/default_smp_affinity", "0").replace(",", ""), 16)
    except ValueError:
        return set()
    return {n for n in range(64) if mask >> n & 1}


def log(msg: str) -> None:
    print(f"konkr-standby: {msg}", flush=True)


def game_pids() -> list[int]:
    children: dict[int, list[int]] = {}
    roots = []
    for p in os.listdir("/proc"):
        if not p.isdigit():
            continue
        try:
            with open(f"/proc/{p}/stat", "rb") as fh:
                st = fh.read()
            ppid = int(st[st.rfind(b")") + 2:].split()[1])
            with open(f"/proc/{p}/cmdline", "rb") as fh:
                cmd = fh.read()
        except (OSError, ValueError, IndexError):
            continue
        children.setdefault(ppid, []).append(int(p))
        if b"reaper\0SteamLaunch\0" in cmd:
            roots.append(int(p))
    out, stack = [], list(roots)
    while stack:
        pid = stack.pop()
        for c in children.get(pid, ()):
            out.append(c)
            stack.append(c)
    return out


def power_key_fd() -> int | None:
    for e in glob.glob("/sys/class/input/event*"):
        if rd(f"{e}/device/name") in ("pmic_pwrkey", "pm8941_pwrkey"):  # SM8650 / SM8250
            return os.open(f"/dev/input/{os.path.basename(e)}", os.O_RDONLY)
    return None


def lid_fd() -> int | None:
    for e in glob.glob("/sys/class/input/event*"):
        if rd(f"{e}/device/name") == "gpio-keys-lid":
            return os.open(f"/dev/input/{os.path.basename(e)}", os.O_RDONLY)
    return None


# Keep audio and D-Bus running while freezing the graphical user.
KEEP_RUNNING = {"pipewire.service", "pipewire-pulse.service", "wireplumber.service",
                "dbus-broker.service", "at-spi-dbus-bus.service", "init.scope"}


def freeze_targets() -> list[str]:
    """cgroups to freeze: each session scope, every user-manager slice but
    session.slice, and every session.slice unit but KEEP_RUNNING."""
    out = []
    try:
        uid = pwd.getpwnam("steamos").pw_uid
        own = next(line.split(":", 2)[2].strip() for line in
                   open("/proc/self/cgroup") if line.startswith("0::"))
    except (KeyError, OSError, StopIteration):
        return []
    own = os.path.normpath("/sys/fs/cgroup" + own)
    for user in glob.glob(f"/sys/fs/cgroup/user.slice/user-{uid}.slice"):
        for child in sorted(os.listdir(user)):
            path = os.path.join(user, child)
            if not os.path.isdir(path):
                continue
            if not (child.startswith("user@") and child.endswith(".service")):
                out.append(path)                  # session-N.scope
                continue
            for sub in sorted(os.listdir(path)):
                spath = os.path.join(path, sub)
                if not os.path.isdir(spath) or sub in KEEP_RUNNING:
                    continue
                if sub != "session.slice":
                    out.append(spath)             # app.slice, …
                    continue
                for unit in sorted(os.listdir(spath)):
                    upath = os.path.join(spath, unit)
                    if os.path.isdir(upath) and unit not in KEEP_RUNNING:
                        out.append(upath)
    # A caller inside a graphical session must never freeze itself or the
    # session coordinating its wake-up. Root SSH sessions are not selected.
    return [path for path in out
            if own != path and not own.startswith(path + "/")]


# System services that only turn input into input while the screen is off.
# InputPlumber reads every report the controller MCU streams (hundreds a
# second) and keeps the CPUs from their deepest idle all night. The power key
# is read here directly, so waking does not need it.
FREEZE_SYSTEM = ["/sys/fs/cgroup/system.slice/inputplumber.service"]


def battery_now() -> dict:
    for b in glob.glob("/sys/class/power_supply/*"):
        if rd(f"{b}/type") != "Battery":
            continue
        out = {"pct": rd(f"{b}/capacity")}
        for k in ("energy_now", "charge_now", "voltage_now", "status"):
            out[k] = rd(f"{b}/{k}")
        return out
    return {}


def interrupts() -> dict[str, int]:
    """IRQ name -> count summed over CPUs."""
    out: dict[str, int] = {}
    lines = rd("/proc/interrupts").splitlines()
    if not lines:
        return out
    ncpu = len(lines[0].split())
    for line in lines[1:]:
        f = line.split()
        if not f:
            continue
        counts = [int(x) for x in f[1:1 + ncpu] if x.isdigit()]
        name = " ".join(f[1 + len(counts):])[-40:] or f[0]
        out[f"{f[0]} {name}"] = sum(counts)
    return out


def standby_report(t0: float, b0: dict, irq0: dict[str, int]) -> None:
    """Battery used and the busiest interrupts, for standby drain reports
    (journalctl -b | grep konkr-standby)."""
    hours = (time.monotonic() - t0) / 3600
    b1 = battery_now()
    msg = f"standby report: {hours:.2f} h"
    try:
        p0, p1 = int(b0["pct"]), int(b1["pct"])
        msg += f", battery {p0}% -> {p1}%"
        if hours > 0.05:
            msg += f" ({(p0 - p1) / hours:.1f} %/h)"
    except (KeyError, ValueError):
        pass
    try:
        if b0.get("energy_now") and b1.get("energy_now"):
            mwh = (int(b0["energy_now"]) - int(b1["energy_now"])) / 1000
        else:
            uv = int(b1.get("voltage_now") or 0)
            mwh = (int(b0["charge_now"]) - int(b1["charge_now"])) / 1000 * uv / 1e6
        if hours > 0.05 and mwh > 0:
            msg += f", ~{mwh / hours:.0f} mW"
    except (KeyError, ValueError):
        pass
    if b1.get("status") and b1["status"] != "Discharging":
        msg += f" ({b1['status'].lower()})"
    irq1 = interrupts()
    secs = max(1.0, hours * 3600)
    top = sorted(((irq1[k] - irq0.get(k, 0), k) for k in irq1), reverse=True)[:6]
    msg += "; irq/s: " + ", ".join(f"{k} {d / secs:.1f}" for d, k in top if d > 0)
    log(msg)


def set_frozen(cgroups: list[str], frozen: bool) -> list[str]:
    """Write cgroup.freeze; returns the cgroups that took it."""
    done = [cg for cg in cgroups if wr_ok(f"{cg}/cgroup.freeze", 1 if frozen else 0)]
    if frozen:
        end = time.monotonic() + 2.0              # let tasks reach the freezer
        while time.monotonic() < end and any(
                "frozen 1" not in rd(f"{cg}/cgroup.events") for cg in done):
            time.sleep(0.05)
    return done


WAKE_R, WAKE_W = os.pipe()


def wait_power_press(fd: int, lid: int | None = None) -> None:
    """Block until a full press+release of the power key, the lid opens, or SIGUSR1."""
    pressed = False
    watch = [fd, WAKE_R] + ([lid] if lid is not None else [])
    while True:
        r, _, _ = select.select(watch, [], [])
        if WAKE_R in r:
            log("wake requested (SIGUSR1)")
            return
        if lid is not None and lid in r:
            data = os.read(lid, EV.size * 64)
            for off in range(0, len(data) - EV.size + 1, EV.size):
                _s, _u, t, code, val = EV.unpack_from(data, off)
                if t == EV_SW and code == SW_LID and val == 0:
                    log("wake: lid opened")
                    return
        data = os.read(fd, EV.size * 64) if fd in r else b""
        for off in range(0, len(data) - EV.size + 1, EV.size):
            _s, _u, t, code, val = EV.unpack_from(data, off)
            if t == EV_KEY and code == KEY_POWER:
                if val == 1:
                    pressed = True
                elif val == 0 and pressed:
                    log("wake: power key")
                    return


def main() -> int:
    fd = power_key_fd()
    if fd is None:
        log("no power key device; not entering standby")
        return 1
    lid = lid_fd()
    open(FLAG, "w").close()
    saved: dict[str, str] = {}
    paused: list[int] = []
    offlined: list[int] = []
    frozen: list[str] = []
    try:
        # Drain the press that triggered sleep, so its release is not the wake.
        time.sleep(0.6)
        os.set_blocking(fd, False)
        try:
            while os.read(fd, EV.size * 64):
                pass
        except BlockingIOError:
            pass
        os.set_blocking(fd, True)

        signal.signal(signal.SIGUSR1, lambda *_: os.write(WAKE_W, b"x"))
        for pid in game_pids():
            try:
                os.kill(pid, signal.SIGSTOP)
                paused.append(pid)
            except OSError:
                pass
        for bl in glob.glob("/sys/class/backlight/*"):
            saved[f"{bl}/brightness"] = rd(f"{bl}/brightness")
            wr(f"{bl}/brightness", 0)
        for led in glob.glob("/sys/class/leds/*"):
            n = os.path.basename(led)
            zone = n.startswith("rgb:") and n[4:5] in ("l", "r") and n[5:].isdigit()
            if "joystick" in n or "power-led" in n or zone:
                saved[f"{led}/brightness"] = rd(f"{led}/brightness")
                wr(f"{led}/brightness", 0)
        run("/usr/lib/konkr/konkr-sleep", "standby-pre")
        time.sleep(0.3)               # let gamescope commit the panel-off
        frozen = set_frozen(freeze_targets() + [c for c in FREEZE_SYSTEM if os.path.isdir(c)], True)
        for pol in glob.glob("/sys/devices/system/cpu/cpufreq/policy*"):
            # konkrd's touch boost may still hold the floor up (it drops it
            # within 0.5 s of this flag); a max below the min would be refused.
            wr(f"{pol}/scaling_min_freq", rd(f"{pol}/cpuinfo_min_freq"))
            saved[f"{pol}/scaling_max_freq"] = rd(f"{pol}/scaling_max_freq")
            wr(f"{pol}/scaling_max_freq", rd(f"{pol}/cpuinfo_min_freq"))
        # SM8550: no CPU hotplug and no GPU clamp. Even with one big core kept
        # online the RP6 still never woke up from standby (only a 10 s hold
        # got it back, beta 7); the Adreno 740's GMU is the fragile part.
        # Frozen apps + screen off + CPU clocks at minimum are enough there.
        sm8550 = is_sm8550()
        for cpu in ([] if sm8550 else big_cpus()):
            if wr_ok(f"/sys/devices/system/cpu/cpu{cpu}/online", 0):
                offlined.append(cpu)
        for gpu in ([] if sm8550 else glob.glob("/sys/class/devfreq/*gpu*")):
            saved[f"{gpu}/max_freq"] = rd(f"{gpu}/max_freq")
            freqs = sorted(int(f) for f in rd(f"{gpu}/available_frequencies").split() if f.isdigit())
            if freqs:
                wr(f"{gpu}/max_freq", freqs[0])
        how = (f"{len(frozen)} session cgroups frozen (audio kept running)" if frozen
               else "session NOT frozen")
        log(f"standby: paused {len(paused)} game processes, {how}, "
            f"cpus {offlined} offline, screen off")
        t0, b0, irq0 = time.monotonic(), battery_now(), interrupts()
        wait_power_press(fd, lid)
        log("wake")
        try:
            standby_report(t0, b0, irq0)
        except Exception as exc:  # never keep the device asleep over a report
            log(f"standby report failed: {exc}")
    finally:
        # CPUs and clocks first, then audio (PipeWire is still running), then
        # the apps, so they wake to a ready speaker and a current clock.
        for cpu in offlined:
            wr(f"/sys/devices/system/cpu/cpu{cpu}/online", 1)
        for path, val in saved.items():
            if val and ("/cpufreq/" in path or "/devfreq/" in path):
                wr(path, val)
        run("/usr/lib/konkr/konkr-sleep", "standby-audio-on")
        if frozen:
            set_frozen(frozen, False)
        run("/usr/lib/konkr/konkr-sleep", "standby-screen-on")
        for path, val in saved.items():
            if val and "/cpufreq/" not in path and "/devfreq/" not in path:
                wr(path, val)
        run("/usr/lib/konkr/konkr-sleep", "standby-post")
        for pid in paused:
            try:
                os.kill(pid, signal.SIGCONT)
            except OSError:
                pass
        time.sleep(0.5)               # let the wake release settle before konkrd sees keys
        try:
            os.remove(FLAG)
        except OSError:
            pass
        os.close(fd)
        if lid is not None:
            os.close(lid)
        # konkrd re-applies profile clocks/LEDs on SIGHUP
        os.system("systemctl kill -s HUP konkrd.service >/dev/null 2>&1")
    return 0


if __name__ == "__main__":
    sys.exit(main())
