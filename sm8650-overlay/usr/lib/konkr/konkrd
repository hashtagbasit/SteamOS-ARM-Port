# pwmfan: ROCKNIX DT fans (Pocket FIT, SM8550). nx669j_fan: REDMAGIC 6 fan MCU.
FAN_HWMON_NAMES = ("pwmfan", "nx669j_fan")


def find_fan() -> str | None:
    for d in sorted(glob.glob("/sys/class/hwmon/hwmon*")):
        if rd(f"{d}/name") in FAN_HWMON_NAMES:
            return d
    return None


def soc_temp_c() -> float:
    """Hottest CPU/GPU tsens zone, °C."""
    hottest = None
    for z in glob.glob("/sys/class/thermal/thermal_zone*"):
        t = rd(f"{z}/type")
        if not (t.startswith("cpu") or t.startswith("gpu") or "gpuss" in t):
            continue
        try:
            value = int(rd(f"{z}/temp")) / 1000.0
            if -20 <= value <= 150:
                hottest = value if hottest is None else max(hottest, value)
        except ValueError:
            pass
    if hottest is None:
        raise RuntimeError("no valid CPU/GPU temperature sensor")
    return hottest


def curve_temp_c() -> tuple[float, float]:
    """(what the fan curve follows, the hottest zone), °C. The curve follows
    the mean of the three hottest CPU/GPU zones: one core alone runs several
    degrees over the rest and jumps with every burst, which kept the fan
    hunting and loud. The single hottest still drives the safety rules."""
    temps = []
    for z in glob.glob("/sys/class/thermal/thermal_zone*"):
        t = rd(f"{z}/type")
        if not (t.startswith("cpu") or t.startswith("gpu") or "gpuss" in t):
            continue
        try:
            value = int(rd(f"{z}/temp")) / 1000.0
        except ValueError:
            continue
        if -20 <= value <= 150:
            temps.append(value)
    if not temps:
        raise RuntimeError("no valid CPU/GPU temperature sensor")
    top = sorted(temps, reverse=True)[:3]
    return sum(top) / len(top), top[0]


def hottest_zone() -> str:
    best, name = -1.0, "?"
    for z in glob.glob("/sys/class/thermal/thermal_zone*"):
        t = rd(f"{z}/type")
        if not (t.startswith("cpu") or t.startswith("gpu") or "gpuss" in t):
            continue
        try:
            v = int(rd(f"{z}/temp", "0")) / 1000.0
        except ValueError:
            continue
        if v > best:
            best, name = v, t
    return name


# The network Wi-Fi is on and its channel, for konkr-sleep: NetworkManager
# drops the connection as soon as a sleep is asked for, so after waking it
# needs a full scan (12 s with a DFS channel in it) before it can reconnect.
# Scanning just this channel first gets it back in about a second.
WIFI_LAST = "/run/konkr/wifi-last"


def record_wifi() -> None:
    try:
        out = subprocess.run(["iw", "dev", "wlan0", "link"], capture_output=True,
                             text=True, timeout=3).stdout
    except (OSError, subprocess.SubprocessError):
        return
    ssid = freq = ""
    for line in out.splitlines():
        line = line.strip()
        if line.startswith("SSID: "):
            ssid = line[6:]
        elif line.startswith("freq: "):
            freq = line[6:].split(".")[0]
    if not ssid or not freq.isdigit():
        return
    try:
        os.makedirs(os.path.dirname(WIFI_LAST), exist_ok=True)
        with open(WIFI_LAST + ".tmp", "w") as f:
            f.write(f"{freq}\n{ssid}\n")
        os.replace(WIFI_LAST + ".tmp", WIFI_LAST)
    except OSError:
        pass


def curve_pwm(curve, temp: float) -> int:
    if temp <= curve[0][0]:
        return curve[0][1]
    for (t0, p0), (t1, p1) in zip(curve, curve[1:]):
        if temp <= t1:
            return int(p0 + (p1 - p0) * (temp - t0) / (t1 - t0))
    return curve[-1][1]


# A burst (waking, opening a menu, a loading screen) runs the big cores flat
# out for a moment and their hotspot sensors jump 40 °C in under a second.
# Only a reading that stays hot counts as hot; the chip's own limits (LMh)
# cover the seconds in between.
HOT_TICKS = 3
DANGER_C = 100
# Waking from s2idle is such a burst on every core at once: the fan holds its
# speed this long after a resume.
RESUME_SETTLE_S = 8.0

FIXED_OVERRIDE_ON_C = 90
FIXED_OVERRIDE_OFF_C = 82
# Standby (konkr-standby, screen off): fan off while the SoC is below this.
# The curves never go under their lowest point (35/255 on balanced), so the
# fan kept spinning all night in standby and drained the battery (Pocket S2).
STANDBY_FAN_OFF_C = 60


def game_fan(st: dict) -> dict | None:
    """The fan settings in force: the running game's own (state "fan_games",
    set in Handheld Control) over the global ones. A game entry is either
    {"curve": "silent"|"balanced"|"turbo"} or {"mode": "fixed", "fixed": n};
    fan boost still wins."""
    glob_fan = st.get("fan") or {}
    entry = (st.get("fan_games") or {}).get(str(CURRENT_APPID)) if CURRENT_APPID else None
    if not entry:
        return glob_fan
    out = {"boost": glob_fan.get("boost", False)}
    if entry.get("mode") == "fixed":
        out.update(mode="fixed", fixed=int(entry.get("fixed", 50)))
    else:
        out.update(mode="auto", curve=entry.get("curve", ""))
    return out


class Fan:
    def __init__(self, conf):
        self.dir = find_fan()
        self.enabled = conf.getboolean("fan", "enabled") and self.dir is not None
        self.min_pwm = conf.getint("fan", "min_pwm")
        self.failsafe = conf.getint("fan", "failsafe_pwm")
        self.cur = -1
        self.smooth = None
        self.set_temp = 0.0
        self.hot_override = False
        self.hot_ticks = 0
        self.slept = None
        self.settle_until = 0.0
        if self.enabled:
            wr(f"{self.dir}/pwm1_enable", 1)
            log(f"fan: {self.dir}")
        elif self.dir is None:
            log("fan: no fan hwmon found")

    def tick(self, profile: str, fan: dict | None = None, standby: bool = False) -> None:
        if not self.enabled:
            return
        fan = fan or {}
        # Time spent asleep shows as CLOCK_BOOTTIME pulling ahead of
        # CLOCK_MONOTONIC: just woke up, so let the resume burst pass.
        slept = time.clock_gettime(time.CLOCK_BOOTTIME) - time.monotonic()
        if self.slept is not None and slept - self.slept > 1.0:
            self.settle_until = time.monotonic() + RESUME_SETTLE_S
        self.slept = slept
        try:
            follow, raw = curve_temp_c()
        except RuntimeError:
            wr(f"{self.dir}/pwm1", 255)
            self.cur = 255
            self.smooth = None
            return
        if standby and raw < STANDBY_FAN_OFF_C:
            if self.cur != 0 and wr(f"{self.dir}/pwm1", 0):
                log(f"fan: standby, {raw:.0f} C -> off")
                self.cur = 0
            # the curve picks up from here on wake (going up is immediate)
            self.smooth = raw
            self.set_temp = raw
            return
        # Safety: never hold a low fixed speed when hot. Latched with
        # hysteresis: under load the SoC sits right at 90 °C, and flipping
        # every tick between the fixed speed and the curve (100 % there) made
        # the fan pulse (user report, v1.1).
        if fan.get("mode") == "fixed":
            if not self.hot_override and raw >= FIXED_OVERRIDE_ON_C:
                self.hot_override = True
                log(f"fan: {raw:.0f} C, overriding the fixed speed until {FIXED_OVERRIDE_OFF_C} C")
            elif self.hot_override and raw <= FIXED_OVERRIDE_OFF_C:
                self.hot_override = False
                log(f"fan: {raw:.0f} C, back to the fixed speed")
            if self.hot_override:
                fan = {**fan, "mode": "auto"}
        else:
            self.hot_override = False
        if fan.get("mode") == "fixed":
            step = max(0, min(255, int(int(fan.get("fixed", 50)) * 2.55)))
            if step != self.cur and wr(f"{self.dir}/pwm1", step):
                log(f"fan: fixed {fan.get('fixed')}% -> pwm {step}")
                self.cur = step
            return
        if fan.get("curve") in FAN_CURVES:
            profile = fan["curve"]          # a game's own curve (game_fan())
        if fan.get("boost"):
            profile = "turbo"
        # Smooth short spikes (boot, shader compiles) but react at once to
        # genuinely hot readings.
        # Genuinely hot: the chip as a whole at 85 C, or any one sensor at
        # 95 C. A single hotspot touching 85 for a moment while the rest sat
        # near 60 used to throw the fan from 30 to 100 % (RP6, Silent).
        if time.monotonic() < self.settle_until and raw < DANGER_C:
            return
        self.hot_ticks = self.hot_ticks + 1 if (follow >= 85 or raw >= 95) else 0
        hot = self.hot_ticks >= HOT_TICKS or raw >= DANGER_C
        if self.smooth is None or hot:
            self.smooth = follow
        else:
            self.smooth = 0.85 * self.smooth + 0.15 * follow
        temp = self.smooth
        want = max(self.min_pwm, curve_pwm(FAN_CURVES[profile], temp))
        if want > self.cur:
            # up: at most 20 a second (a burst no longer makes it surge),
            # straight there when the chip is genuinely hot
            step = want if hot or self.cur < 0 else min(want, self.cur + 20)
            self.set_temp = temp
        elif want < self.cur and temp <= self.set_temp - 3:
            step = max(want, self.cur - 15)      # down: once 3 °C below, ramp
        else:
            return
        if step != self.cur and wr(f"{self.dir}/pwm1", step):
            if abs(step - self.cur) >= 40 or self.cur < 0:
                log(f"fan: {temp:.1f} C (hottest {raw:.0f} C, {hottest_zone()}) -> pwm {step}")
            self.cur = step

    def failsafe_now(self) -> None:
        if self.dir:
            wr(f"{self.dir}/pwm1", self.failsafe)


def shutting_down() -> bool:
    try:
        r = subprocess.run(["systemctl", "is-system-running"], capture_output=True,
                           text=True, timeout=2)
        return r.stdout.strip() == "stopping"
    except (OSError, subprocess.SubprocessError):
        return False


# ------------------------------------------------------------------ gpu ----
def gpu_devfreq() -> str | None:
    for d in glob.glob("/sys/class/devfreq/*"):
        if "gpu" in os.path.basename(d) or "3d00000" in d:
            return d
    return None


def is_sm8550() -> bool:
    try:
        return b"qcom,sm8550" in open("/proc/device-tree/compatible", "rb").read()
    except OSError:
        return False


def apply_gpu(profile: str) -> None:
    d = gpu_devfreq()
    if not d:
        return
    freqs = sorted(int(f) for f in rd(f"{d}/available_frequencies").split() if f.isdigit())
    if not freqs:
        return
    lo, hi = GPU_RANGE[profile]
    fmin = freqs[int(lo * (len(freqs) - 1))]
    fmax = freqs[int(round(hi * (len(freqs) - 1)))]
    # order matters: never set min above the current max
    wr(f"{d}/max_freq", freqs[-1])
    wr(f"{d}/min_freq", fmin)
    wr(f"{d}/max_freq", fmax)
    # 16 ms polling is tuned for the 8 Gen 3. On the 8 Gen 2 it cost about
    # 20% of the 1% lows (measured on an RP6), so it keeps the default there.
    if not is_sm8550():
        wr(f"{d}/polling_interval", 16)


def fanless() -> bool:
    """Tablets (Lenovo Legion Y700 Gen 3 / Gen 4) have no fan: pinning the big
    cores there only heats the chip into GPU throttling, and Turbo ran games
    slower than Balanced."""
    compat = rd("/sys/firmware/devicetree/base/compatible").split("\0")
    return "lenovo,tb321fu" in compat or "lenovo,elden" in compat


def apply_cpu(profile: str) -> None:
    """schedutil everywhere (the ROCKNIX default is `performance`, which
    holds all eight cores — little A520s included — at max clock: heat for
    nothing). Turbo pins only the big clusters to `performance`, except on a
    fanless tablet, where Turbo keeps only its higher GPU floor."""
    big = set() if fanless() else big_cpus()
    for pol in glob.glob("/sys/devices/system/cpu/cpufreq/policy*"):
        govs = rd(f"{pol}/scaling_available_governors")
        cpus = {int(c) for c in rd(f"{pol}/related_cpus").split() if c.isdigit()}
        gov = "schedutil"
        if profile == "turbo" and cpus and cpus <= big and "performance" in govs:
            gov = "performance"
        if gov in govs:
            wr(f"{pol}/scaling_governor", gov)
        if gov == "schedutil":
            wr(f"{pol}/schedutil/rate_limit_us", 500)
        wr(f"{pol}/scaling_max_freq", rd(f"{pol}/cpuinfo_max_freq"))


def big_cpus() -> set[int]:
    """CPUs not in the lowest-capacity cluster (drops the Cortex-A520s)."""
    caps = {}
    for c in glob.glob("/sys/devices/system/cpu/cpu[0-9]*"):
        n = int(os.path.basename(c)[3:])
        try:
            caps[n] = int(rd(f"{c}/cpu_capacity", "0")) or int(rd(f"{c}/cpufreq/cpuinfo_max_freq", "0"))
        except ValueError:
            caps[n] = 0
    if not caps:
        return set()
    low = min(caps.values())
    big = {n for n, v in caps.items() if v > low}
    return big or set(caps)


# ---------------------------------------------------------- game boost ----
class SchedAttr(ctypes.Structure):
    _fields_ = [("size", ctypes.c_uint32), ("sched_policy", ctypes.c_uint32),
                ("sched_flags", ctypes.c_uint64), ("sched_nice", ctypes.c_int32),
                ("sched_priority", ctypes.c_uint32), ("sched_runtime", ctypes.c_uint64),
                ("sched_deadline", ctypes.c_uint64), ("sched_period", ctypes.c_uint64),
                ("sched_util_min", ctypes.c_uint32), ("sched_util_max", ctypes.c_uint32)]


SYS_SCHED_SETATTR = 274  # aarch64
SCHED_FLAG_KEEP_ALL = 0x08 | 0x10
SCHED_FLAG_UTIL_CLAMP_MIN = 0x20
_libc = ctypes.CDLL(None, use_errno=True)


def set_uclamp_min(tid: int, value: int) -> bool:
    attr = SchedAttr()
    attr.size = ctypes.sizeof(SchedAttr)
    attr.sched_flags = SCHED_FLAG_KEEP_ALL | SCHED_FLAG_UTIL_CLAMP_MIN
    attr.sched_util_min = value
    return _libc.syscall(SYS_SCHED_SETATTR, tid, ctypes.byref(attr), 0) == 0


# Steam App ID of the running game (from its `reaper SteamLaunch AppId=` launcher),
# 0 when none. Written by scan_procs(); per-game fan settings key on it.
CURRENT_APPID = 0
GAME_FILE = "/run/konkr/game.json"


def scan_procs() -> tuple[set[int], list[int]]:
    """One /proc pass: (game pids, UI pids). Descendants of Steam's
    `reaper SteamLaunch` are the game; UI_COMMS outside it are the UI.
    comm comes from stat, and cmdline is read only for `reaper`: this runs
    every second, and reading three files per process cost ~5 % CPU idle."""
    global CURRENT_APPID
    children: dict[int, list[int]] = {}
    roots, ui, appids = [], [], []
    for p in os.listdir("/proc"):
        if not p.isdigit():
            continue
        pid = int(p)
        try:
            with open(f"/proc/{p}/stat", "rb") as fh:
                stat = fh.read()
            r = stat.rfind(b")")
            comm = stat[stat.find(b"(") + 1:r].decode(errors="replace")
            ppid = int(stat[r + 2:].split()[1])
        except (OSError, ValueError, IndexError):
            continue
        children.setdefault(ppid, []).append(pid)
        if comm in UI_COMMS:
            ui.append(pid)
        elif comm == "reaper":
            try:
                with open(f"/proc/{p}/cmdline", "rb") as fh:
                    cmd = fh.read()
            except OSError:
                continue
            # argv: /…/reaper SteamLaunch AppId=<id> -- <game>
            if b"reaper\0SteamLaunch\0" in cmd:
                roots.append(pid)
                m = re.search(rb"\0AppId=(\d+)\0", cmd)
                if m:
                    appids.append(int(m.group(1)))
    appid = appids[-1] if appids else 0
    if appid != CURRENT_APPID:
        CURRENT_APPID = appid
        try:
            os.makedirs(os.path.dirname(GAME_FILE), exist_ok=True)
            with open(GAME_FILE + ".tmp", "w", encoding="utf-8") as fh:
                json.dump({"appid": appid}, fh)
            os.replace(GAME_FILE + ".tmp", GAME_FILE)
        except OSError:
            pass
    out, stack = set(), list(roots)
    while stack:
        pid = stack.pop()
        for c in children.get(pid, ()):
            if c not in out:
                out.add(c)
                stack.append(c)
    return out, [u for u in ui if u not in out]


class GameBoost:
    def __init__(self, conf):
        self.enabled = conf.getboolean("games", "boost")
        self.avoid_little = conf.getboolean("games", "avoid_little_cores")
        self.big = big_cpus()
        self.done: dict[int, int] = {}  # tid → uclamp value applied

    def tick(self, profile: str) -> None:
        if not self.enabled:
            return
        live = set()
        games, ui = scan_procs()
        targets = [(pid, GAME_UCLAMP[profile]) for pid in games]
        targets += [(pid, UI_UCLAMP[profile]) for pid in ui]
        games_set = set(games)
        for pid, val in targets:
            if pid in games_set:
                io = IO_GAME
            elif rd(f"/proc/{pid}/comm") in IO_LOW_COMMS:
                io = IO_DOWNLOAD
            else:
                io = IO_UI
            for t in glob.glob(f"/proc/{pid}/task/*"):
                tid = int(os.path.basename(t))
                live.add(tid)
                if self.done.get(tid) == val:
                    continue
                set_ioprio(tid, io)
                try:
                    if self.avoid_little and self.big:
                        os.sched_setaffinity(tid, self.big)
                except OSError:
                    pass
                set_uclamp_min(tid, val)
                self.done[tid] = val
        for tid in list(self.done):
            if tid not in live:
                del self.done[tid]


