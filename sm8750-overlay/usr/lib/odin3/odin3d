# The network Wi-Fi is on and its channel, for steamos-arm-wifi-wake: after
# waking it scans just that channel first instead of NetworkManager's full
# scan (12 s with a DFS channel in it).
WIFI_LAST = "/run/konkr/wifi-last"


def record_wifi() -> None:
    try:
        out = subprocess.run(["iw", "dev", "wlan0", "link"], capture_output=True,
                             text=True, timeout=3).stdout
    except (OSError, subprocess.SubprocessError):
        return
    ssid = freq = ""
    for line in out.splitlines():
        line = line.strip()
        if line.startswith("SSID: "):
            ssid = line[6:]
        elif line.startswith("freq: "):
            freq = line[6:].split(".")[0]
    if not ssid or not freq.isdigit():
        return
    try:
        os.makedirs(os.path.dirname(WIFI_LAST), exist_ok=True)
        with open(WIFI_LAST + ".tmp", "w") as f:
            f.write(f"{freq}\n{ssid}\n")
        os.replace(WIFI_LAST + ".tmp", WIFI_LAST)
    except OSError:
        pass


def rd(path: str, default: str = "") -> str:
    try:
        with open(path, encoding="utf-8") as fh:
            return fh.read().strip()
    except OSError:
        return default


def wr(path: str, value: Any) -> bool:
    try:
        with open(path, "w", encoding="utf-8") as fh:
            fh.write(str(value))
        return True
    except OSError:
        return False


def parse_curve(val: str) -> list[tuple[int, int]]:
    points = []
    for item in val.split(","):
        item = item.strip()
        if not item or ":" not in item:
            continue
        try:
            t, p = item.split(":", 1)
            points.append((int(t.strip()), max(0, min(255, int(p.strip())))))
        except ValueError:
            continue
    points.sort(key=lambda x: x[0])
    return points


def curve_pwm(curve: list[tuple[int, int]], temp: float) -> int:
    if not curve:
        return 70
    if temp <= curve[0][0]:
        return curve[0][1]
    for (t0, p0), (t1, p1) in zip(curve, curve[1:]):
        if temp <= t1:
            if t1 == t0:
                return p0
            return int(p0 + (p1 - p0) * (temp - t0) / (t1 - t0))
    return curve[-1][1]



def shutting_down() -> bool:
    try:
        r = subprocess.run(["systemctl", "is-system-running"], capture_output=True,
                           text=True, timeout=2)
        return r.stdout.strip() == "stopping"
    except (OSError, subprocess.SubprocessError):
        return False


class Config:
    def __init__(self, path: str = CONF_PATH):
        self.path = path
        self.reload()

    def reload(self) -> None:
        cp = configparser.ConfigParser()
        cp.read_dict({
            "fan": {
                "enabled": "yes",
                "min_pwm": "0",
                "max_pwm": "255",
                "failsafe_pwm": "150",
                "poll_interval_s": "1.0",
                "temp_smoothing": "0.15",
                "hysteresis_c": "3.0",
                "ramp_down_step": "15",
                "critical_temp_c": "88.0",
                "critical_exit_c": "78.0",
            },
            "power": {
                "manage_cpu": "yes",
                "manage_gpu": "yes",
            },
            "curves": {
                "silent": "48:0, 55:30, 65:55, 75:90, 85:160, 92:255",
                "balanced": "45:0, 50:35, 60:65, 70:105, 80:165, 88:220, 93:255",
                "turbo": "40:70, 50:100, 60:140, 70:190, 80:235, 86:255",
            },
        })
        cp.read(self.path)

        self.fan_enabled = cp.getboolean("fan", "enabled")
        self.min_pwm = max(0, min(255, cp.getint("fan", "min_pwm")))
        self.max_pwm = max(0, min(255, cp.getint("fan", "max_pwm")))
        self.failsafe_pwm = max(0, min(255, cp.getint("fan", "failsafe_pwm")))
        self.poll_interval = max(0.2, cp.getfloat("fan", "poll_interval_s"))
        self.smoothing = max(0.01, min(1.0, cp.getfloat("fan", "temp_smoothing")))
        self.hysteresis = max(0.5, cp.getfloat("fan", "hysteresis_c"))
        self.ramp_down_step = max(1, cp.getint("fan", "ramp_down_step"))
        self.critical_temp = cp.getfloat("fan", "critical_temp_c")
        self.critical_exit = cp.getfloat("fan", "critical_exit_c")

        self.manage_cpu = cp.getboolean("power", "manage_cpu")
        self.manage_gpu = cp.getboolean("power", "manage_gpu")

        self.curves: dict[str, list[tuple[int, int]]] = {}
        for p in PROFILES:
            raw = cp.get("curves", p, fallback="")
            parsed = parse_curve(raw)
            self.curves[p] = parsed if parsed else DEFAULT_CURVES[p]


class StateManager:
    def __init__(self, path: str = STATE_PATH):
        self.path = path
        self.data: dict[str, Any] = {}
        self.load()

    def load(self) -> dict[str, Any]:
        try:
            with open(self.path, encoding="utf-8") as fh:
                self.data = json.load(fh)
        except (OSError, ValueError):
            self.data = {}

        self.data.setdefault("profile", "balanced")
        if self.data["profile"] not in PROFILES:
            self.data["profile"] = "balanced"

        self.data.setdefault("fan", {"mode": "auto", "fixed": 50, "boost": False})
        fan = self.data["fan"]
        fan.setdefault("mode", "auto")
        fan.setdefault("fixed", 50)
        fan.setdefault("boost", False)

        self.data.setdefault("rgb", {"mode": "static", "color": "ff3c00", "brightness": 160})
        rgb = self.data["rgb"]
        rgb.setdefault("mode", "static")
        rgb.setdefault("color", "ff3c00")
        rgb.setdefault("brightness", 160)

        return self.data

    def save(self) -> None:
        os.makedirs(os.path.dirname(self.path), exist_ok=True)
        tmp = f"{self.path}.tmp"
        with open(tmp, "w", encoding="utf-8") as fh:
            json.dump(self.data, fh, indent=2)
        os.replace(tmp, self.path)


class Hardware:
    def __init__(self, config: Config):
        self.config = config
        self.fan_dir: str | None = None
        self.thermal_zones: list[tuple[str, str]] = []
        self.hottest_zone_name: str = "?"
        self.last_hottest_temp: float = 0.0
        self.rescan()

    def rescan(self) -> None:
        self.fan_dir = None
        for d in sorted(glob.glob("/sys/class/hwmon/hwmon*")):
            if rd(f"{d}/name") == "pwmfan":
                self.fan_dir = d
                break

        if self.fan_dir:
            wr(f"{self.fan_dir}/pwm1_enable", 1)

        # Collect CPU / GPU / DDR thermal zones
        self.thermal_zones = []
        for z in sorted(glob.glob("/sys/class/thermal/thermal_zone*")):
            t = rd(f"{z}/type")
            if t.startswith(("cpu", "gpu")) or "gpuss" in t or "cpuss" in t or t == "ddr-thermal":
                self.thermal_zones.append((f"{z}/temp", t))

    def get_soc_temp(self) -> float:
        """Returns hottest temperature in °C across CPU/GPU sensors."""
        if not self.thermal_zones:
            self.rescan()

        hottest = -100.0
        hottest_name = "?"
        for path, name in self.thermal_zones:
            raw = rd(path)
            if not raw:
                continue
            try:
                val = int(raw) / 1000.0
                if -20.0 <= val <= 150.0 and val > hottest:
                    hottest = val
                    hottest_name = name
            except ValueError:
                pass

        if hottest > -100.0:
            self.hottest_zone_name = hottest_name
            self.last_hottest_temp = hottest
            return hottest

        raise RuntimeError("No valid thermal readings found")

    def get_curve_temp(self) -> float:
        """Mean of the three hottest CPU/GPU zones, °C: what the fan curve
        follows. One core alone runs several degrees over the rest and
        spikes with every burst; following it kept the fan hunting."""
        vals = []
        for path, _name in self.thermal_zones:
            raw = rd(path)
            try:
                v = int(raw) / 1000.0 if raw else None
            except ValueError:
                v = None
            if v is not None and -20.0 <= v <= 150.0:
                vals.append(v)
        if not vals:
            raise RuntimeError("No valid thermal readings found")
        top = sorted(vals, reverse=True)[:3]
        return sum(top) / len(top)

    def get_pwm(self) -> int:
        if not self.fan_dir:
            return 0
        try:
            return int(rd(f"{self.fan_dir}/pwm1", "0"))
        except ValueError:
            return 0

    def set_pwm(self, val: int) -> bool:
        if not self.fan_dir:
            self.rescan()
            if not self.fan_dir:
                return False
        val = max(0, min(255, int(val)))
        return wr(f"{self.fan_dir}/pwm1", val)

    def set_failsafe(self) -> None:
        if self.fan_dir:
            self.set_pwm(self.config.failsafe_pwm)


class FanController:
    def __init__(self, hw: Hardware, cfg: Config, state: StateManager):
        self.hw = hw
        self.cfg = cfg
        self.state = state
        self.cur_pwm = -1
        self.smooth_temp: float | None = None
        self.set_temp: float = 0.0
        self.critical_override = False
        # Bursts (waking, menus, loading) run the big cores flat out for a
        # moment and their hotspot sensors jump 40 C in under a second: only a
        # reading that stays hot this long counts as hot. Waking from s2idle
        # does it on every core at once, so the fan holds its speed for a
        # while after a resume.
        self.hot_since: float | None = None
        self.crit_since: float | None = None
        self.slept: float | None = None
        self.settle_until = 0.0

    HOT_HOLD_S = 3.0
    # Past every burst spike seen (103 C): only this is acted on at once.
    DANGER_C = 110.0
    RESUME_SETTLE_S = 8.0

    def tick(self) -> None:
        if not self.cfg.fan_enabled:
            return
        # Time asleep shows as CLOCK_BOOTTIME pulling ahead of CLOCK_MONOTONIC.
        slept = time.clock_gettime(time.CLOCK_BOOTTIME) - time.monotonic()
        if self.slept is not None and slept - self.slept > 1.0:
            self.settle_until = time.monotonic() + self.RESUME_SETTLE_S
        self.slept = slept

        try:
            raw_temp = self.hw.get_soc_temp()
        except RuntimeError as e:
            log(f"warning: {e} -> setting failsafe PWM")
            self.hw.set_failsafe()
            return

        # Critical: the fan at full until the chip cools. Only for heat that
        # stays: the hotspot sensors cross 88 C for a second in every burst
        # (29 times in 4 h of play on an Odin 3, each a 100 % blast for 1-2 s).
        now_c = time.monotonic()
        if raw_temp >= self.cfg.critical_temp:
            if self.crit_since is None:
                self.crit_since = now_c
        else:
            self.crit_since = None
        sustained = self.crit_since is not None and now_c - self.crit_since >= self.HOT_HOLD_S
        if not self.critical_override and (sustained or raw_temp >= self.DANGER_C):
            self.critical_override = True
            log(f"ALERT: {raw_temp:.1f}°C >= {self.cfg.critical_temp}°C! Critical thermal override active (100% fan).")
        elif self.critical_override and raw_temp <= self.cfg.critical_exit:
            self.critical_override = False
            log(f"INFO: {raw_temp:.1f}°C <= {self.cfg.critical_exit}°C. Exiting critical thermal override.")

        fan_st = self.state.data.get("fan", {})
        mode = fan_st.get("mode", "auto")
        boost = fan_st.get("boost", False)
        profile = self.state.data.get("profile", "balanced")

        if self.critical_override:
            target_pwm = self.cfg.max_pwm
            next_pwm = target_pwm
            self.set_temp = raw_temp
        elif boost:
            target_pwm = self.cfg.max_pwm
            next_pwm = target_pwm
            self.set_temp = raw_temp
        elif mode == "fixed":
            fixed_pct = max(0, min(100, int(fan_st.get("fixed", 50))))
            target_pwm = int(round(fixed_pct * 2.55))
            next_pwm = target_pwm
            self.set_temp = raw_temp
        else:
            # Auto mode with profile curve. The curve follows the three
            # hottest zones' mean; it jumps straight there only when the chip
            # is genuinely hot (that mean at 85 C, or one sensor at 95 C), not
            # when a single hotspot touches 82 for a moment.
            try:
                follow = self.hw.get_curve_temp()
            except RuntimeError:
                follow = raw_temp
            if time.monotonic() < self.settle_until and raw_temp < self.DANGER_C:
                return
            now = time.monotonic()
            if follow >= 85.0 or raw_temp >= 95.0:
                if self.hot_since is None:
                    self.hot_since = now
            else:
                self.hot_since = None
            hot = (self.hot_since is not None and now - self.hot_since >= self.HOT_HOLD_S) \
                or raw_temp >= self.DANGER_C
            if self.smooth_temp is None or hot:
                self.smooth_temp = follow
            else:
                alpha = self.cfg.smoothing
                self.smooth_temp = alpha * follow + (1.0 - alpha) * self.smooth_temp

            curve = self.cfg.curves.get(profile, DEFAULT_CURVES["balanced"])
            target_pwm = curve_pwm(curve, self.smooth_temp)
            target_pwm = max(self.cfg.min_pwm, min(self.cfg.max_pwm, target_pwm))

            temp_ref = self.smooth_temp if self.smooth_temp is not None else raw_temp

            if self.cur_pwm < 0:
                # First tick: apply immediately
                next_pwm = target_pwm
                self.set_temp = temp_ref
            elif target_pwm > self.cur_pwm:
                # Ramping UP: at most 20 a tick (a burst no longer makes it
                # surge), straight there when the chip is genuinely hot
                next_pwm = target_pwm if hot else min(target_pwm, self.cur_pwm + 20)
                self.set_temp = temp_ref
            elif target_pwm < self.cur_pwm:
                # Ramping DOWN: check hysteresis or large delta (e.g. exiting boost/fixed)
                large_gap = (self.cur_pwm - target_pwm) >= 30
                cooling_down = temp_ref <= (self.set_temp - self.cfg.hysteresis)

                if large_gap or cooling_down:
                    next_pwm = max(target_pwm, self.cur_pwm - self.cfg.ramp_down_step)
                    self.set_temp = temp_ref
                else:
                    next_pwm = self.cur_pwm
            else:
                next_pwm = self.cur_pwm

        if next_pwm != self.cur_pwm:
            if self.hw.set_pwm(next_pwm):
                if abs(next_pwm - self.cur_pwm) >= 20 or self.cur_pwm < 0:
                    pct = int(round(next_pwm / 2.55))
                    log(f"fan: {raw_temp:.1f}°C ({self.hw.hottest_zone_name}) -> PWM {next_pwm}/255 ({pct}%) [{profile}/{mode}]")
                self.cur_pwm = next_pwm


class PowerManager:
    def __init__(self, cfg: Config):
        self.cfg = cfg

    def apply(self, profile: str) -> None:
        if self.cfg.manage_cpu:
            self.apply_cpu(profile)
        if self.cfg.manage_gpu:
            self.apply_gpu(profile)
        if power_limits:
            try:
                with open(STATE_PATH, encoding="utf-8") as fh:
                    power_limits.apply(json.load(fh))
            except (OSError, ValueError):
                pass

    def apply_cpu(self, profile: str) -> None:
        """Sets CPU governors. Schedutil for balanced/silent, Performance for turbo."""
        for pol in sorted(glob.glob("/sys/devices/system/cpu/cpufreq/policy*")):
            avail = rd(f"{pol}/scaling_available_governors")
            cpus = rd(f"{pol}/related_cpus")
            # policy6 is the two Oryon Prime cores (cpus 6, 7)
            is_prime = ("6" in cpus or "7" in cpus)

            # Not on a fanless tablet (Legion Y700 Gen 4): pinned prime cores
            # heat it into GPU throttling and Turbo ran slower than Balanced.
            if profile == "turbo" and is_prime and "performance" in avail and not FANLESS:
                gov = "performance"
            elif "schedutil" in avail:
                gov = "schedutil"
            elif "ondemand" in avail:
                gov = "ondemand"
            else:
                continue

            wr(f"{pol}/scaling_governor", gov)
            if gov == "schedutil":
                wr(f"{pol}/schedutil/rate_limit_us", 500)

    def apply_gpu(self, profile: str) -> None:
        """Configures GPU devfreq polling and frequency floors/ceilings."""
        gpu_dir = "/sys/class/devfreq/3d00000.gpu"
        if not os.path.isdir(gpu_dir):
            return

        wr(f"{gpu_dir}/polling_interval", 16)
        freqs_str = rd(f"{gpu_dir}/available_frequencies")
        freqs = sorted(int(f) for f in freqs_str.split() if f.isdigit())
        if not freqs:
            return

        min_f, max_f = freqs[0], freqs[-1]
        if profile == "silent":
            # Cap GPU to 832 MHz (index ~9) to prevent heat/power spikes
            cap = next((f for f in freqs if f >= 832000000), max_f)
            wr(f"{gpu_dir}/min_freq", min_f)
            wr(f"{gpu_dir}/max_freq", cap)
        elif profile == "balanced":
            # Full dynamic range 160MHz to 1100MHz
            wr(f"{gpu_dir}/max_freq", max_f)
            wr(f"{gpu_dir}/min_freq", min_f)
        elif profile == "turbo":
            # Raise floor to 443MHz (index ~4) to eliminate frame dips
            floor = next((f for f in freqs if f >= 443000000), min_f)
            wr(f"{gpu_dir}/max_freq", max_f)
            wr(f"{gpu_dir}/min_freq", floor)


# KONKR Pocket FIT Elite: one multicolor LED for both sticks, driven by the
# MCU over its UART (konkr_sysbtn). Every write sends a frame to the MCU.
KONKR_STICK_LED = "/sys/class/leds/konkr:rgb:joysticks"


class LedManager:
    """Manages Left and Right analog stick ring RGB LEDs."""

    def __init__(self):
        self.multi = KONKR_STICK_LED if os.path.isdir(KONKR_STICK_LED) else None
        self.multi_order = ["red", "green", "blue"]
        if self.multi:
            idx = rd(f"{self.multi}/multi_index").split()
            if sorted(idx) == ["blue", "green", "red"]:
                self.multi_order = idx
        self.last_multi = None
        self.left_leds = {
            "r": [f"/sys/class/leds/l:r{i}" for i in range(1, 5)],
            "g": [f"/sys/class/leds/l:g{i}" for i in range(1, 5)],
            "b": [f"/sys/class/leds/l:b{i}" for i in range(1, 5)],
        }
        self.right_leds = {
            "r": [f"/sys/class/leds/r:r{i}" for i in range(1, 5)],
            "g": [f"/sys/class/leds/r:g{i}" for i in range(1, 5)],
            "b": [f"/sys/class/leds/r:b{i}" for i in range(1, 5)],
        }
        self.flash_until = 0.0

    def set_color(self, hex_color: str, brightness: int = 160) -> None:
        hex_color = hex_color.lstrip("#")
        if len(hex_color) != 6 or not all(c in "0123456789abcdefABCDEF" for c in hex_color):
            hex_color = "ff3c00"

        r = int(hex_color[0:2], 16)
        g = int(hex_color[2:4], 16)
        b = int(hex_color[4:6], 16)

        scale = max(0, min(255, brightness)) / 255.0
        r_val = int(round(r * scale))
        g_val = int(round(g * scale))
        b_val = int(round(b * scale))

        if self.multi:
            # Full colour in the intensities, the level in brightness; only
            # write on a change, every write goes over the UART to the MCU.
            chan = {"red": r, "green": g, "blue": b}
            state = (tuple(chan[c] for c in self.multi_order), max(0, min(255, brightness)))
            if state != self.last_multi:
                wr(f"{self.multi}/multi_intensity", " ".join(str(v) for v in state[0]))
                wr(f"{self.multi}/brightness", state[1])
                self.last_multi = state
            return

        for color_key, val in [("r", r_val), ("g", g_val), ("b", b_val)]:
            for path in self.left_leds[color_key] + self.right_leds[color_key]:
                wr(f"{path}/brightness", val)

    def off(self) -> None:
        if self.multi:
            if self.last_multi is None or self.last_multi[1] != 0:
                wr(f"{self.multi}/brightness", 0)
                self.last_multi = ((0, 0, 0), 0)
            return
        for group in (self.left_leds, self.right_leds):
            for paths in group.values():
                for p in paths:
                    wr(f"{p}/brightness", 0)

    def flash_profile(self, profile: str) -> None:
        color = PROFILE_COLORS.get(profile, "00ff66")
        self.set_color(color, 255)
        self.flash_until = time.monotonic() + 1.5

    def tick(self, rgb_state: dict[str, Any]) -> None:
        if time.monotonic() < self.flash_until:
            return
        mode = rgb_state.get("mode", "static")
        if mode == "off":
            self.off()
        elif mode == "static":
            color = rgb_state.get("color", "ff3c00")
            bright = int(rgb_state.get("brightness", 160))
            self.set_color(color, bright)


