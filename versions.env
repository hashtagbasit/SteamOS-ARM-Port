# SteamOS ARM Handhelds — Global Version Manifest
#
# Single source of truth for upstream base images, graphics stacks,
# toolchains, and pre-built distribution assets.
# Sourced by make-steamos-*.sh, build-mesa.sh, and GitHub Actions workflows.

# --- Valve SteamOS Base (Steam Frame / Deckard) ---
STEAMOS_BUILD="20261002.6232440"
STEAMOS_VERSION="0.5.3"
STEAMOS_BUNDLE="deckard-20261002.6232440-0.5.3"
STEAMOS_URL="https://steamdeck-images.steamos.cloud/vr/20261002.6232440"

# --- Mesa Graphics Stack (Turnip Adreno 830 Vulkan + Zink OpenGL) ---
MESA_VERSION="26.2.3"
MESA_SHA256="1628058a8d2c0615975de5a15ab7bbb9638c50000b5bed9456ff423ea034a81f"
NDK_VERSION="r27c"
NDK_SHA1="090e8083a715fdb1a3e402d0763c388abb03fb4e"

# --- Steam Client ARM Bootstrap Channel ---
# The Steam ARM client beta channel bootstrapped in CI (e.g. steamdeck_publicbeta)
STEAM_ARM_CHANNEL="steamdeck_publicbeta"

# --- Kernel & Distribution Upstream Pins ---
# Pinned ROCKNIX release tag used for device trees and baseline kernel configs
ROCKNIX_REF="20260901"
KVER="7.2"

# --- Deterministic Partition & Filesystem Identifiers ---
# Standard partition and filesystem identifiers for predictable partition tables, cmdline, and fstab.
DEFAULT_DISK_ID="53544541"
DEFAULT_ROOT_UUID="e8992e59-b131-41b3-a9d0-fa52e1e3b5e4"
DEFAULT_HOME_UUID="4b2452c9-d2b4-4e78-9588-e0ce26d8ee1c"
DEFAULT_ROOT_HASH_SEED="a1b2c3d4-e5f6-7890-abcd-ef1234567890"
DEFAULT_HOME_HASH_SEED="b2c3d4e5-f6a7-8901-bcde-f12345678901"
SOURCE_DATE_EPOCH="1790294400"
